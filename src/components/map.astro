---
import "../styles/global.css";
import { decodeAddress, payload, translateWeekday } from "../utils";
import type { School, Class } from "../../cms/src/payload-types";

interface Params {
  locale: "en" | "de";
}
const { locale } = Astro.props as Params;

const { docs: classes } = await payload.find({
  collection: "classes",
  locale: locale,
  depth: 1, // Ensures relations like 'dances' are populated
  pagination: false,
});

// Extract unique dances for the filter UI
const uniqueDancesMap = new Map();
classes.forEach(c => {
  if (c.dances && Array.isArray(c.dances)) {
    c.dances.forEach(dance => {
      if (dance && dance.shortName) {
        uniqueDancesMap.set(dance.shortName, dance);
      }
    });
  }
});
const danceFilters = Array.from(uniqueDancesMap.values());

const events = classes.map((clazz) => {
  const school = clazz.school as School;
  const address = decodeAddress(clazz.address);

  return {
    title: clazz.title,
    // Store original weekday string for display, but also the translated one
    weekday: translateWeekday(clazz.weekday, locale),
    rawWeekday: clazz.weekday, // Better for stable filtering logic
    address: address, 
    school: school.name,
    coordinates: [clazz.location[1], clazz.location[0]],
    dances: clazz.dances?.map((d: any) => d.name || d.shortName).join(", "),
    // Array of lowercase shortNames strictly for JS filtering
    danceTags: clazz.dances?.map((d: any) => d.shortName.toLowerCase()) || [],
  };
});
---

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="map-wrapper">
  <div id="map"></div>

  <button class="mobile-filter-toggle" aria-expanded="false">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="filter-icon">
      <line x1="4" y1="21" x2="4" y2="14"></line>
      <line x1="4" y1="10" x2="4" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="12"></line>
      <line x1="12" y1="8" x2="12" y2="3"></line>
      <line x1="20" y1="21" x2="20" y2="16"></line>
      <line x1="20" y1="12" x2="20" y2="3"></line>
      <line x1="1" y1="14" x2="7" y2="14"></line>
      <line x1="9" y1="8" x2="15" y2="8"></line>
      <line x1="17" y1="16" x2="23" y2="16"></line>
    </svg>
    {locale === "de" ? "Filter" : "Filters"}
  </button>

  <div class="filter-panel" id="filter-panel">
    <div class="filter-header-mobile">
      <h3>{locale === "de" ? "Filter" : "Filters"}</h3>
      <button class="close-filter-btn" aria-label="Close filters">✕</button>
    </div>
    <div class="filter-section">

    {danceFilters.length > 0 && (
      <div class="filter-section">
        <h3 class="filter-heading">
          {locale === "de" ? "Nach Tanz" : "By Dance"}
        </h3>
        <div class="dance-filter-options">
          {danceFilters.map((dance) => (
            <button class="listing-tag filter-tag" data-filter={dance.shortName.toLowerCase()}>
              {dance.name || dance.shortName}
            </button>
          ))}
        </div>
      </div>
    )}
      <h3 class="filter-heading">
        {locale === "de" ? "Nach Tag" : "By Day"}
      </h3>
      <div class="day-filter-row">
        <button class="filter-btn active" data-day="all">
          {locale === "de" ? "Alle" : "All"}
        </button>
        <button class="filter-btn" data-day="Monday">{locale === "de" ? "Mo" : "Mon"}</button>
        <button class="filter-btn" data-day="Tuesday">{locale === "de" ? "Di" : "Tue"}</button>
        <button class="filter-btn" data-day="Wednesday">{locale === "de" ? "Mi" : "Wed"}</button>
        <button class="filter-btn" data-day="Thursday">{locale === "de" ? "Do" : "Thu"}</button>
        <button class="filter-btn" data-day="Friday">{locale === "de" ? "Fr" : "Fri"}</button>
        <button class="filter-btn" data-day="Saturday">{locale === "de" ? "Sa" : "Sat"}</button>
        <button class="filter-btn" data-day="Sunday">{locale === "de" ? "So" : "Sun"}</button>
      </div>
    </div>
  </div>
</div>

<script set:html={JSON.stringify(events)} is:inline id="event-data" type="application/json" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script is:inline lang="ts">
  document.addEventListener("DOMContentLoaded", () => {
    // --- Map Initialization ---
    const map = L.map("map", { fadeAnimation: false }).setView(
      [53.5511, 9.9937],
      12,
    );

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution: "© OpenStreetMap",
    }).addTo(map);

    const eventDataElement = document.getElementById("event-data");
    const events = JSON.parse(eventDataElement.textContent);
    const markerLayer = L.layerGroup().addTo(map);

    // Accent dot markers instead of the default blue pin
    const dotIcon = L.divIcon({
      className: "sih-map-marker",
      iconSize: [16, 16],
      iconAnchor: [8, 8],
      popupAnchor: [0, -8],
    });

    // Filter States
    let currentDayFilter = "all";
    let activeDanceFilters = new Set();

    function renderMarkers() {
      markerLayer.clearLayers();

      events.forEach((event) => {
        // 1. Check Day Condition
        const dayMatch = currentDayFilter === "all" || event.rawWeekday === currentDayFilter;

        // 2. Check Dance Condition
        let danceMatch = true;
        if (activeDanceFilters.size > 0) {
          danceMatch = event.danceTags.some(tag => activeDanceFilters.has(tag));
        }

        // 3. Render if both match
        if (dayMatch && danceMatch) {
          const marker = L.marker(event.coordinates, { icon: dotIcon }).bindPopup(
            `
            <div class="custom-popup-content">
              <strong>${event.school}</strong><br/>
              <span>${event.address.street} ${event.address.num}, ${event.address.quarter}</span><br/>
              <div class="popup-date-time">
                ${event.weekday}
              </div>
              <div class="popup-title">${event.dances}</div>
            </div>
          `,
            {
              className: "custom-popup",
              closeButton: false,
              offset: [0, -10],
            }
          );
          markerLayer.addLayer(marker);
        }
      });
    }

    // Initial render
    renderMarkers();

    // --- Filter UI Logic ---
    const filterPanel = document.getElementById("filter-panel");
    const mobileToggleBtn = document.querySelector(".mobile-filter-toggle");
    const closeBtn = document.querySelector(".close-filter-btn");
    
    // Day Buttons
    const dayButtons = document.querySelectorAll(".filter-btn");
    // Dance Buttons
    const danceButtons = document.querySelectorAll(".filter-tag");

    function toggleMobileDrawer() {
      if (window.innerWidth <= 768) {
        filterPanel.classList.toggle("open");
      }
    }

    if (mobileToggleBtn) mobileToggleBtn.addEventListener("click", toggleMobileDrawer);
    if (closeBtn) closeBtn.addEventListener("click", toggleMobileDrawer);

    // Day Filter Event Listeners
    dayButtons.forEach((button) => {
      button.addEventListener("click", (e) => {
        dayButtons.forEach((btn) => btn.classList.remove("active"));
        e.target.classList.add("active");

        currentDayFilter = e.target.dataset.day;
        renderMarkers();
      });
    });

    // Dance Filter Event Listeners
    danceButtons.forEach((button) => {
      button.addEventListener("click", (e) => {
        const target = e.target;
        const filterValue = target.dataset.filter;

        if (activeDanceFilters.has(filterValue)) {
          activeDanceFilters.delete(filterValue);
          target.classList.remove("selected");
        } else {
          activeDanceFilters.add(filterValue);
          target.classList.add("selected");
        }
        renderMarkers();
      });
    });
  });
</script>

<style>
  .map-wrapper {
    position: relative;
    width: 100%;
    height: clamp(22rem, calc(100dvh - 22rem), 56rem);
    display: flex;
    overflow: hidden;
  }

  #map {
    width: 100%;
    height: 100%; 
    z-index: 1;
  }

  .main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0;
  }

  #map-container {
    flex: 1;
    width: 100%;
  }

  /* --- Filter Panel Base --- */
  .filter-panel {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 1000;
    background: var(--surface);
    color: var(--text-main);
    padding: 1.5rem;
    border-radius: 0.75rem;
    box-shadow: 0 4px 16px rgba(40, 70, 110, 0.12);
    max-width: 20rem;
    
    /* Adds scroll if filters stack too tall */
    max-height: calc(100vh - 100px);
    overflow-y: auto;
  }

  .filter-section {
    margin-bottom: 1.5rem;
  }

  .filter-section:last-child {
    margin-bottom: 0;
  }

  .filter-heading {
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.1;
    color: var(--text-main);
  }

  .filter-options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .dance-filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

/* --- Day Filter Row --- */
  .day-filter-row {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap; /* Allows buttons to drop to the next line safely */
    gap: 8px;
  }

  .filter-btn {
    flex: 1 1 calc(25% - 8px); /* Forces them to neatly fill rows of 4 */
    min-width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    color: var(--text-main);
    border: 1px solid var(--rule-color);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: 700;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.1s ease;
    padding: 0;
  }

  @media (hover: hover) {
    .filter-btn:hover {
      background-color: var(--accent-soft);
      color: var(--accent);
    }
  }

  .filter-btn.active {
    background-color: var(--text-main);
    color: var(--bg-main);
    border-color: var(--text-main);
  }

  .filter-btn:active {
    transform: scale(0.95); /* Adds a nice pressed effect */
  }

  /* Dance tags inside the filter panel use the outlined pill variant */
  .filter-panel .listing-tag {
    background-color: transparent;
    color: var(--text-main);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .filter-panel .listing-tag.selected {
    background-color: var(--accent);
    color: var(--accent-contrast);
  }

  @media (hover: hover) {
    .filter-panel .listing-tag:hover {
      background-color: var(--accent);
      color: var(--accent-contrast);
    }
  }

  .mobile-filter-toggle,
  .filter-header-mobile {
    display: none;
  }

  .filter-toggle {
    position: absolute;
    right: 0;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-main);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    width: 40px;  /* Ensures a perfect circle */
    height: 40px; 
    border-radius: 50%; /* Prepares the circular hover background */
    transition: 
      background-color 0.2s ease, 
      transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (hover: hover) {
    .filter-toggle:hover {
      background-color: var(--accent-soft); /* Soft highlight */
      transform: scale(1.1);     /* Slight pop forward */
      opacity: 1;                /* Overrides your old opacity drop */
    }
  }

  .filter-toggle:active {
    transform: scale(0.95);    /* Satisfying squish when clicked */
    background-color: var(--accent-soft);
  }

  .close-filter-btn {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--text-main);
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
  .mobile-filter-toggle {
      display: flex !important; /* Changed to flex */
      align-items: center;      /* Vertically centers the icon and text */
      gap: 8px;                 /* Adds spacing between icon and text */
      position: absolute;
      bottom: 1rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 999;
      background-color: var(--text-main);
      color: var(--bg-main);
      border: none;
      padding: 0.75rem 1.5rem;
      border-radius: 999px;
      font-family: var(--font-body);
      font-weight: 700;
      box-shadow: 0 4px 12px rgba(40, 70, 110, 0.25);
      transition: 
        transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), 
        background-color 0.2s ease, 
        box-shadow 0.25s ease !important;
    }

    @media (hover: hover) {
      .mobile-filter-toggle:hover {
        /* IMPORTANT: We keep translateX(-50%) so it stays perfectly centered */
        transform: translateX(-50%) scale(1.05);
        background-color: var(--accent);
        box-shadow: 0 6px 16px rgba(138, 74, 228, 0.35);
      }
    }

    .mobile-filter-toggle:active {
      transform: translateX(-50%) scale(0.95); 
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    }

    .filter-header-mobile {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      font-size: var(--font-emph);
    }

    .filter-panel {
      position: fixed;
      top: auto;
      bottom: 0;
      right: 0;
      left: 0;
      max-width: 100%;
      border-radius: 16px 16px 0 0;
      transform: translateY(100%);
      transition: transform 0.3s ease-in-out;
      max-height: 85vh;
      overflow-y: auto;
      padding: 1.5rem 1.5rem 7rem 1.5rem;
    }

    .filter-panel.open {
      transform: translateY(0);
    }
  }

  /* Tint the OpenStreetMap tiles into the beige/violet palette: desaturate,
     then warm them across to the accent hue and let the beige page colour
     show through so they read as lavender-grey rather than purple. */
  #map {
    background-color: var(--bg-main);
  }

  #map :global(.leaflet-tile-pane) {
    filter: grayscale(1) sepia(0.5) hue-rotate(200deg) saturate(2.0)
      brightness(0.82) contrast(2.0);
    /* Multiply keeps the pale land beige while the violet roads, water and
       labels stay dark enough to read. */
    mix-blend-mode: multiply;
  }

  #map :global(.leaflet-control-zoom a) {
    background-color: var(--bg-main);
    color: var(--text-main);
    border-color: var(--rule-color);
  }

  #map :global(.leaflet-control-zoom a:hover) {
    background-color: var(--accent-soft);
    color: var(--accent);
  }

  #map :global(.leaflet-control-attribution) {
    background-color: color-mix(in srgb, var(--bg-main) 85%, transparent);
    color: var(--text-main);
  }

  #map :global(.leaflet-control-attribution a) {
    color: var(--accent);
  }
</style>

<style is:global>
  /* Accent dot markers (created at runtime, so they live in global CSS) */
  .sih-map-marker {
    box-sizing: border-box;
    width: 16px;
    height: 16px;
    border: 3px solid var(--bg-main);
    border-radius: 50%;
    background-color: var(--accent);
    box-shadow: 0 1px 4px rgba(40, 70, 110, 0.35);
    transition:
      transform 0.15s ease,
      background-color 0.15s ease;
  }

  .sih-map-marker:hover {
    background-color: var(--text-main);
    transform: scale(1.15);
  }

  /* Container override */
  .custom-popup .leaflet-popup-content-wrapper {
    background: var(--surface);
    border-radius: 0.75rem;
    box-shadow: 0 4px 16px rgba(40, 70, 110, 0.15);
    padding: 2px;
    width: 200px;
  }

  .custom-popup .leaflet-popup-tip {
    display: none;
  }

  .custom-popup .leaflet-popup-content {
    margin: 12px;
    width: auto !important; 
    font-family: var(--font-body);
    color: var(--text-main);
    line-height: 1.3;
  }

  .custom-popup-content strong {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.1;
    display: block;
  }

  .custom-popup-content span {
    font-size: var(--fs-body);
    color: var(--text-main);
  }

  .popup-date-time {
    font-size: var(--fs-body);
    font-style: italic;
    margin-top: 6px;
  }

  .popup-title {
    font-size: var(--fs-body);
    font-weight: 500;
    margin-top: 2px;
  }
</style>
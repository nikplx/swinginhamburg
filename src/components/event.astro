---
import RichText from "./richtText.astro";
import type { OccurrenceView } from "../utils";
import {
  decodeAddress,
  formatLocalDate,
  formatLocalTime,
} from "../utils";

interface Props {
  occurrence: OccurrenceView;
  /** Classes are grouped by weekday, so the date chip is redundant there. */
  hideDate?: boolean;
}
const { occurrence, hideDate = false } = Astro.props;
const locale = (Astro.params.locale ?? "de") as string;

const event = occurrence.event;
const venue = event.location ?? null;
const address = decodeAddress(venue?.address);

const organizers = event.organizers.filter((organizer) => organizer.name);

const danceTags = event.danceStyles.length
  ? event.danceStyles.map((style) => ({
      name: style.shortName ?? style.name ?? "",
      slug: style.slug ?? style.shortName ?? "style",
    }))
  : [
      {
        name: locale === "en" ? "Style not specified" : "Stil nicht angegeben",
        slug: "none",
      },
    ];

function levelLabel(level: string, lang: string): string {
  const labels: Record<string, Record<string, string>> = {
    all: { de: "Alle Niveaus", en: "All levels" },
    beginner: { de: "Anfänger", en: "Beginner" },
    intermediate: { de: "Mittelstufe", en: "Intermediate" },
    advanced: { de: "Fortgeschritten", en: "Advanced" },
    open: { de: "Offen", en: "Open" },
  };
  return labels[level]?.[lang] ?? level;
}

const dayLabel = formatLocalDate(occurrence.start, locale, {
  weekday: "short",
  day: "2-digit",
  month: "2-digit",
});
const timeLabel = formatLocalTime(occurrence.start);
const endLabel = formatLocalTime(occurrence.end);
---

<div class:list={["workshop-item", { "is-cancelled": occurrence.cancelled }]}>
  {
    hideDate ? (
      <div class="workshop-time">{timeLabel}–{endLabel}</div>
    ) : (
      <div class="workshop-date">
        {dayLabel} · {timeLabel}–{endLabel}
      </div>
    )
  }

  <h3 class="workshop-title">
    {event.title}
    {
      occurrence.cancelled && (
        <span class="cancelled-badge">
          {locale === "en" ? "cancelled" : "fällt aus"}
        </span>
      )
    }
  </h3>

  {
    organizers.length > 0 && (
      <div class="workshop-organizers">
        {organizers.map((organizer, index) => (
          <>
            {index > 0 && " · "}
            {organizer.slug ? (
              <a
                href={`/${locale}/organizations#${organizer.slug}`}
                class="organizer-link">
                {organizer.name}
              </a>
            ) : (
              <span>{organizer.name}</span>
            )}
          </>
        ))}
      </div>
    )
  }

  {
    venue && (venue.name || venue.address) && (
      <div class="workshop-location">
        {venue.name && <strong>{venue.name}</strong>}
        {venue.name && venue.address && <> | </>}
        {venue.address
          ? `${address.street} ${address.num}, ${address.quarter || address.city}`
          : null}
        {venue.directionsNote && (
          <span class="directions-note"> · {venue.directionsNote}</span>
        )}
      </div>
    )
  }

  {
    occurrence.note && <p class="occurrence-note">{occurrence.note}</p>
  }

  <div class="workshop-desc-container collapsed">
    <div class="workshop-desc">
      {
        typeof event.description === "string" ? (
          <p>{event.description as string}</p>
        ) : (
          <RichText content={event.description} />
        )
      }
    </div>
    <button class="toggle-desc-btn" aria-expanded="false">
      <span>{locale === "en" ? "Show more" : "Mehr anzeigen"}</span>
    </button>
  </div>

  <div class="listing-tags-row">
    <div class="workshop-tags-group">
      {
        danceTags.map((tag) => {
          const href = `/${locale}/swing#${String(tag.slug)
            .replace(/\s+/g, "-")
            .toLowerCase()}`;
          return (
            <a href={href} class="listing-tag">
              {tag.name}
            </a>
          );
        })
      }
    </div>
    {
      event.level && (
        <div class="workshop-level">
          {levelLabel(event.level, locale)}
        </div>
      )
    }
  </div>
</div>

<script>
  const containers = document.querySelectorAll(".workshop-desc-container");

  containers.forEach((container) => {
    const button = container.querySelector(".toggle-desc-btn");
    const span = button?.querySelector("span");

    button?.addEventListener("click", () => {
      const isCollapsed = container.classList.toggle("collapsed");
      button.setAttribute("aria-expanded", (!isCollapsed).toString());
      if (span) {
        const isGerman = document.documentElement.lang === "de";
        span.textContent = isCollapsed
          ? isGerman
            ? "Mehr anzeigen"
            : "Show more"
          : isGerman
            ? "Weniger anzeigen"
            : "Show less";
      }
    });
  });
</script>

<style>
  .workshop-item {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.625rem 0 1rem 0;
    border-bottom: var(--rule-width) solid var(--rule-color);
    margin: 0;
  }

  .workshop-item.is-cancelled {
    opacity: 0.7;
  }

  .workshop-date {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    min-height: 1.5rem;
    padding: 0.0625rem 0.625rem;
    border-radius: 999px;
    background-color: var(--accent);
    color: var(--accent-contrast);
    font-size: var(--fs-body);
    font-weight: 600;
    font-style: italic;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .workshop-time {
    font-size: var(--fs-body);
    font-weight: 600;
    font-style: italic;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .workshop-title {
    font-family: var(--font-display);
    font-size: var(--fs-row);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--text-main);
    margin: 0.25rem 0 0 0;
  }

  .cancelled-badge {
    margin-left: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .workshop-organizers {
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1.2;
  }

  .organizer-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  @media (hover: hover) {
    .organizer-link:hover {
      color: var(--accent);
    }
  }

  .workshop-location {
    font-size: var(--fs-body);
    line-height: 1.2;
    color: var(--text-main);
  }

  .workshop-location strong {
    font-weight: 400;
  }

  .directions-note {
    font-size: var(--fs-body);
    color: var(--text-muted);
  }

  .occurrence-note {
    margin: 0;
    font-size: var(--fs-body);
    color: var(--accent);
  }

  .workshop-desc {
    font-size: var(--fs-body);
    line-height: 1.33;
    color: var(--text-main);
  }

  .workshop-desc :global(p) {
    margin: 0 0 0.75em 0;
  }

  .listing-tags-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  .workshop-tags-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    flex: 1;
  }

  .workshop-level {
    font-size: var(--fs-body);
    font-weight: 700;
    color: var(--text-main);
    white-space: nowrap;
    margin-left: auto;
  }

  .toggle-desc-btn {
    display: none;
  }

  @media (max-width: 768px) {
    .workshop-desc-container {
      position: relative;
      margin-bottom: 0.625rem;
    }

    .workshop-desc-container.collapsed .workshop-desc {
      max-height: 4.5em;
      overflow: hidden;
      position: relative;
    }

    .workshop-desc-container.collapsed .workshop-desc::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 2.5em;
      background: linear-gradient(to bottom, transparent, var(--bg-main) 90%);
      pointer-events: none;
    }

    .toggle-desc-btn {
      display: block;
      background: none;
      border: none;
      color: var(--accent);
      font-family: var(--font-body);
      font-size: var(--fs-body);
      font-weight: 600;
      padding: 0.25rem 0;
      margin-top: 0.25rem;
      cursor: pointer;
      text-decoration: underline;
    }
  }
</style>

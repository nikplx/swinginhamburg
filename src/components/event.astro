---
import RichText from "./richtText.astro";
import type { Locale } from "../i18n";
import { danceKey, timeRange, type OccurrenceView } from "../lib/occurrences";
import { shortAddress } from "../lib/location";

interface Props {
  occurrence: OccurrenceView;
  /** Classes are grouped by weekday, so the date chip is redundant there. */
  hideDate?: boolean;
}
const { occurrence, hideDate = false } = Astro.props;
const locale = Astro.params.locale as Locale; // validated in src/middleware.ts

const event = occurrence.event;
const venue = event.location ?? null;
const venueAddress = shortAddress(venue);

const organizers = event.organizers.filter((organizer) => organizer.name);

// Tags link to the dance's section on the swing page, which uses the same key.
const danceTags = event.danceStyles.length
  ? event.danceStyles.map((style) => ({
      name: style.shortName ?? style.name ?? "",
      href: `/${locale}/swing#${danceKey(style)}`,
    }))
  : [
      {
        name: locale === "en" ? "Style not specified" : "Stil nicht angegeben",
        href: `/${locale}/swing`,
      },
    ];

function levelLabel(level: string, lang: string): string {
  const labels: Record<string, Record<string, string>> = {
    all: { de: "Alle Niveaus", en: "All levels" },
    beginner: { de: "Anfänger", en: "Beginner" },
    intermediate: { de: "Mittelstufe", en: "Intermediate" },
    advanced: { de: "Fortgeschritten", en: "Advanced" },
    open: { de: "Offen", en: "Open" },
  };
  return labels[level]?.[lang] ?? level;
}

// Dates stay in the German convention on both language versions. `date` is
// the local calendar day, so format it at noon UTC to avoid zone shifts.
const dayLabel = new Intl.DateTimeFormat("de-DE", {
  timeZone: "UTC",
  weekday: "short",
  day: "2-digit",
  month: "2-digit",
}).format(new Date(`${occurrence.date}T12:00:00Z`));
const time = timeRange(occurrence);
---

<div class:list={["workshop-item", { "is-cancelled": occurrence.cancelled }]}>
  {
    occurrence.cancelled && occurrence.note && (
      <p class="occurrence-note occurrence-note--cancelled">
        <span class="occurrence-note__icon" aria-hidden="true">
          ⚠
        </span>
        {occurrence.note}
      </p>
    )
  }

  {
    hideDate ? (
      time && <div class="workshop-time">{time}</div>
    ) : (
      <div class="workshop-date">
        {time ? `${dayLabel} · ${time}` : dayLabel}
      </div>
    )
  }

  <h3 class="workshop-title">
    {event.title}
    {
      occurrence.cancelled && (
        <span class="cancelled-badge">
          {locale === "en" ? "cancelled" : "fällt aus"}
        </span>
      )
    }
  </h3>

  {
    organizers.length > 0 && (
      <div class="workshop-organizers">
        {organizers.map((organizer, index) => (
          <>
            {index > 0 && " · "}
            {organizer.slug ? (
              <a
                href={`/${locale}/organizations#${organizer.slug}`}
                class="organizer-link">
                {organizer.name}
              </a>
            ) : (
              <span>{organizer.name}</span>
            )}
          </>
        ))}
      </div>
    )
  }

  {
    venue && (venue.name || venueAddress) && (
      <div class="workshop-location">
        {venue.name && <strong>{venue.name}</strong>}
        {venue.name && venueAddress && <> | </>}
        {venueAddress}
        {venue.directionsNote && (
          <span class="directions-note"> · {venue.directionsNote}</span>
        )}
      </div>
    )
  }

  {
    occurrence.note && !occurrence.cancelled && (
      <p class="occurrence-note">{occurrence.note}</p>
    )
  }

  <div class="workshop-desc-container collapsed">
    <div class="workshop-desc">
      {
        typeof event.description === "string" ? (
          <p>{event.description as string}</p>
        ) : (
          <RichText content={event.description} />
        )
      }
    </div>
    <button class="toggle-desc-btn" aria-expanded="false">
      <span>{locale === "en" ? "Show more" : "Mehr anzeigen"}</span>
    </button>
  </div>

  <div class="listing-tags-row">
    <div class="workshop-tags-group">
      {
        danceTags.map((tag) => (
          <a href={tag.href} class="listing-tag">
            {tag.name}
          </a>
        ))
      }
    </div>
    {
      event.level && (
        <div class="workshop-level">
          {levelLabel(event.level, locale)}
        </div>
      )
    }
  </div>
</div>

<script>
  // Collapse long descriptions on every screen size and only show the toggle
  // when the text actually overflows. Descriptions in inactive tabs report a
  // zero height, so a ResizeObserver re-checks them when the tab is revealed.
  const setupDescCollapse = (container: Element) => {
    if (container.hasAttribute("data-collapse-ready")) return;

    const desc = container.querySelector(".workshop-desc") as HTMLElement | null;
    const button = container.querySelector(".toggle-desc-btn");
    const span = button?.querySelector("span");
    if (!desc || !button || !span) return;

    container.setAttribute("data-collapse-ready", "true");

    const isGerman = document.documentElement.lang.startsWith("de");
    const moreLabel = isGerman ? "Mehr anzeigen" : "Show more";
    const lessLabel = isGerman ? "Weniger anzeigen" : "Show less";

    const sync = () => {
      // offsetParent is null while the tab is hidden — measure later.
      if (!desc.offsetParent) return;
      const overflows = desc.scrollHeight - desc.clientHeight > 1;
      container.classList.toggle("has-overflow", overflows);
      if (!overflows) {
        container.classList.remove("collapsed");
        button.setAttribute("aria-expanded", "true");
      }
    };

    button.addEventListener("click", () => {
      const isCollapsed = container.classList.toggle("collapsed");
      button.setAttribute("aria-expanded", String(!isCollapsed));
      span.textContent = isCollapsed ? moreLabel : lessLabel;
    });

    if (typeof ResizeObserver !== "undefined") {
      new ResizeObserver(() => {
        if (container.classList.contains("collapsed")) sync();
      }).observe(desc);
    }

    sync();
  };

  const initDescCollapse = () => {
    document.querySelectorAll(".workshop-desc-container").forEach(setupDescCollapse);
  };

  initDescCollapse();
</script>

<style>
  .workshop-item {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.625rem 0 1rem 0;
    border-bottom: var(--rule-width) solid var(--rule-color);
    margin: 0;
  }

  .workshop-item.is-cancelled > * {
    opacity: 0.7;
  }

  /* The notice stays fully visible so the cancellation reason is readable. */
  .workshop-item.is-cancelled > .occurrence-note {
    opacity: 1;
  }

  .workshop-item.is-cancelled
    :is(
      .workshop-date,
      .workshop-time,
      .workshop-title,
      .workshop-organizers,
      .workshop-location,
      .workshop-desc,
      .listing-tag,
      .workshop-level
    ) {
    text-decoration: line-through;
  }

  .workshop-item.is-cancelled .cancelled-badge {
    display: inline-block;
    text-decoration: none;
  }

  .workshop-date {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    min-height: 1.5rem;
    padding: 0.0625rem 0.625rem;
    border-radius: 999px;
    background-color: var(--accent);
    color: var(--accent-contrast);
    font-size: var(--fs-body);
    font-weight: 600;
    font-style: italic;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .workshop-time {
    font-size: var(--fs-body);
    font-weight: 600;
    font-style: italic;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .workshop-title {
    font-family: var(--font-display);
    font-size: var(--fs-row);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--text-main);
    margin: 0.25rem 0 0 0;
  }

  .cancelled-badge {
    margin-left: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .workshop-organizers {
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1.2;
  }

  .organizer-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  @media (hover: hover) {
    .organizer-link:hover {
      color: var(--accent);
    }
  }

  .workshop-location {
    font-size: var(--fs-body);
    line-height: 1.2;
    color: var(--text-main);
  }

  .workshop-location strong {
    font-weight: 400;
  }

  .directions-note {
    font-size: var(--fs-body);
    color: var(--text-muted);
  }

  .occurrence-note {
    margin: 0;
    font-size: var(--fs-body);
    color: var(--accent);
  }

  .occurrence-note--cancelled {
    font-weight: 600;
  }

  .occurrence-note__icon {
    margin-right: 0.25rem;
  }

  .workshop-desc {
    font-size: var(--fs-body);
    line-height: 1.33;
    color: var(--text-main);
  }

  .workshop-desc :global(p) {
    margin: 0 0 0.75em 0;
  }

  .listing-tags-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  .workshop-tags-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    flex: 1;
  }

  .workshop-level {
    font-size: var(--fs-body);
    font-weight: 700;
    color: var(--text-main);
    white-space: nowrap;
    margin-left: auto;
  }

  .toggle-desc-btn {
    display: none;
  }

  .workshop-desc-container {
    position: relative;
  }

  .workshop-desc-container.collapsed .workshop-desc {
    max-height: 4.5em;
    overflow: hidden;
    position: relative;
  }

  .workshop-desc-container.collapsed .workshop-desc::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2.5em;
    background: linear-gradient(to bottom, transparent, var(--bg-main) 90%);
    pointer-events: none;
  }

  .workshop-desc-container.has-overflow {
    margin-bottom: 0.625rem;
  }

  .workshop-desc-container.has-overflow .toggle-desc-btn {
    display: block;
    background: none;
    border: none;
    color: var(--accent);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: 600;
    padding: 0.25rem 0;
    margin-top: 0.25rem;
    cursor: pointer;
    text-decoration: underline;
  }
</style>

---
import Wave from "./wave.astro";
import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const currentPath = Astro.url.pathname;

// Trailing slashes are ignored when matching the active page.
const normalizePath = (path: string) => path.replace(/\/$/, "");
const isActive = (href: string) =>
  normalizePath(currentPath) === normalizePath(href);

const otherLocale = locale === "en" ? "de" : "en";
const otherLocaleLink = currentPath.replace(`/${locale}`, `/${otherLocale}`);

const labelsByLocale: Record<Locale, Record<string, string>> = {
  de: {
    index: "Socials / Events / Kurse",
    map: "Karte",
    organizations: "Lernen",
    swing: "Neu hier?",
    about: "Über uns",
  },
  en: {
    index: "Socials / Events / Classes",
    map: "Map",
    organizations: "Schools",
    swing: "Get started",
    about: "About",
  },
};

const labels = labelsByLocale[locale];

const navItems = [
  { href: `/${locale}`, label: labels.index },
  { href: `/${locale}/map`, label: labels.map },
  { href: `/${locale}/organizations`, label: labels.organizations },
  { href: `/${locale}/swing`, label: labels.swing },
  { href: `/${locale}/about`, label: labels.about },
];
---

{/* Plain wrapper (no custom element is defined); it is the flex item in the header row. */}
<mobile-nav>
  <nav class="site-nav">
    <button
      class="menu-toggle"
      type="button"
      aria-label={locale === "de" ? "Menü umschalten" : "Toggle navigation menu"}
      aria-controls="site-nav-links"
      aria-expanded="false">
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

    <div class="nav-links" id="site-nav-links">
      {
        navItems.map((item) => (
          <a href={item.href} class={`nav-item ${isActive(item.href) ? "active" : ""}`}>
            {item.label}
          </a>
        ))
      }
      <Wave />
    </div>

    <span class="lang-switch">
      <a
        href={locale === "de" ? currentPath : otherLocaleLink}
        class={locale === "de" ? "active" : ""}
        hreflang="de">DE</a
      ><span class="lang-divider">/</span><a
        href={locale === "en" ? currentPath : otherLocaleLink}
        class={locale === "en" ? "active" : ""}
        hreflang="en">EN</a
      >
    </span>
  </nav>
</mobile-nav>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const navLinks = document.querySelector<HTMLElement>(".nav-links");

  if (menuToggle && navLinks) {
    const setOpen = (open: boolean) => {
      menuToggle.classList.toggle("active", open);
      menuToggle.setAttribute("aria-expanded", String(open));
      navLinks.classList.toggle("open", open);
      document.documentElement.classList.toggle("menu-open", open);
    };
    const isOpen = () => navLinks.classList.contains("open");

    menuToggle.addEventListener("click", (event) => {
      // Keep this click from reaching the click-outside handler below.
      event.stopPropagation();
      setOpen(!isOpen());
    });

    // Close on clicks outside the menu and on Escape.
    document.addEventListener("click", (event) => {
      if (isOpen() && !navLinks.contains(event.target as Node | null)) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        setOpen(false);
        menuToggle.focus();
      }
    });
  }
</script>

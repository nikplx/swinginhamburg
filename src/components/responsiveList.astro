---
interface Props {
  /** Only one item open at a time within this list. */
  exclusiveOpen?: boolean;
  /** Marks the list as the anchor for the sidebar wave alignment. */
  anchor?: boolean;
}

const { exclusiveOpen = true, anchor = false } = Astro.props;
---
<div
  class="responsive-list"
  data-exclusive-open={exclusiveOpen.toString()}
  data-sidebar-anchor={anchor ? "" : undefined}>
  <slot />
</div>

<script>
  import { setAccordionOpen } from "../scripts/accordion";

  const isExclusive = (item: Element) =>
    item.closest(".responsive-list")?.getAttribute("data-exclusive-open") === "true";

  const closeSiblings = (item: Element) => {
    item
      .closest(".responsive-list")
      ?.querySelectorAll(".responsive-item.open")
      .forEach((other) => other !== item && setAccordionOpen(other, false));
  };

  // Open the item a URL hash points to (e.g. /organizations#some-school) and
  // scroll it below the sticky header, whose height depends on the viewport.
  function openFromHash() {
    const id = decodeURIComponent(window.location.hash.slice(1));
    const item = id ? document.getElementById(id) : null;
    if (!item?.classList.contains("responsive-item")) return;

    if (isExclusive(item)) closeSiblings(item);
    setAccordionOpen(item, true);

    const headerHeight = document.querySelector(".site-header")?.getBoundingClientRect().height ?? 0;
    const top = window.scrollY + item.getBoundingClientRect().top - headerHeight - 12;
    window.scrollTo({ top, behavior: "smooth" });
  }

  document.querySelectorAll(".responsive-item-header").forEach((header) => {
    header.addEventListener("click", () => {
      const item = header.parentElement;
      if (!item) return;
      const open = !item.classList.contains("open");
      if (open && isExclusive(item)) closeSiblings(item);
      setAccordionOpen(item, open);
    });
  });

  // Wait a tick so layout (fonts, sticky header) settles before scrolling.
  if (window.location.hash) setTimeout(openFromHash, 100);
  window.addEventListener("hashchange", openFromHash);
</script>

<style>
  .responsive-list {
    width: 100%;
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-bottom: var(--rule-width) solid var(--rule-color);
  }

  .responsive-list + :global(*) {
    margin-top: 2rem;
  }
</style>

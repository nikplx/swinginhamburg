---
import type { School, Class } from "../../cms/src/payload-types.ts";
import { decodeAddress } from "../utils.ts";

interface Props {
  classs: Class;
}
const { classs: clazz } = Astro.props as Props;

const school = (clazz.school as School) || { name: "" };
const address = decodeAddress(clazz.address);

const danceTags =
  clazz.dances && clazz.dances.length > 0
    ? clazz.dances.map((dance) =>
        typeof dance === "string" ? dance : dance.shortName,
      )
    : [clazz.title];

// ID formatting to match: school.name.replaceAll(" ", "").toLocaleLowerCase()
const schoolSlug = school.name
  ? school.name.replaceAll(" ", "").toLocaleLowerCase()
  : "";
const schoolHref = `/${Astro.currentLocale}/schools#${schoolSlug}`;
---

<div class="listing-item">
  <div class="listing-details">
    <span class="listing-school">
      {
        school.name ? (
          <a href={schoolHref} class="school-link">
            {school.name}
          </a>
        ) : (
          ""
        )
      }
    </span>

    <span class="listing-address">
      <a
        href={"http://maps.google.com/?q=" + clazz.address}
        target="_blank"
        rel="noopener noreferrer">
        {
          clazz.locationName && (
            <>
              <strong>{clazz.locationName}</strong>
              <> | </>
            </>
          )
        }
        {address.street} {address.num}, {address.quarter}
      </a>
    </span>

    {clazz.cancelled && <span class="cancelled-text">⚠ {clazz.cancelled}</span>}
  </div>

  {
    danceTags.length > 0 && (
      <div class="listing-tags-wrapper">
        {danceTags.map((tag) => {
          const slug = typeof tag === "string" ? tag : tag.shortName;
          const href = `/${Astro.currentLocale}/swing#${String(slug)
            .replace(/\s+/g, "-")
            .toLowerCase()}`;

          return (
            <a href={href} class="listing-tag">
              {tag}
            </a>
          );
        })}
      </div>
    )
  }
</div>

<style>
  .listing-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.625rem 0 1rem 0;
    border-bottom: var(--rule-width) solid var(--rule-color);
  }

  .listing-details {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .listing-school {
    font-family: var(--font-display);
    font-size: var(--fs-row);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--text-main);
  }

  .school-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .school-link:hover {
    color: var(--accent);
  }

  .listing-address {
    font-size: var(--fs-h3);
    line-height: 1.2;
    color: var(--text-main);
  }

  .listing-address strong {
    font-weight: 400;
  }

  .listing-address a {
    color: inherit;
    text-decoration: none;
  }

  .listing-address a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    color: inherit;
  }

  .cancelled-text {
    font-size: var(--fs-body);
    color: var(--accent);
  }

  .listing-tags-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.5rem;
  }
</style>

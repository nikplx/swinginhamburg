---
// Squiggle divider from the design (thin, hand-drawn wave)
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const id = `wave-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={["wave", className]}
  height="13"
  width="100%"
  aria-hidden="true"
  preserveAspectRatio="none">
  <defs>
    <pattern id={id} width="48" height="15" patternUnits="userSpaceOnUse">
      <path
        d="M-24 6.5 Q-12 15.5 0 6.5 Q12 -2.5 24 6.5 T48 6.5 T72 6.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      />
    </pattern>
    
  </defs>
  <rect width="100%" height="13" fill={`url(#${id})`} />
  
</svg>

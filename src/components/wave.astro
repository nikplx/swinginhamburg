---
// Squiggle divider from the design (thin, hand-drawn wave)
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const id = `wave-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={["wave", className]}
  height="11"
  width="100%"
  aria-hidden="true"
  preserveAspectRatio="none">
  <defs>
    <pattern id={id} width="48" height="11" patternUnits="userSpaceOnUse">
      <path
        d="M0 5.5 Q12 -3.5 24 5.5 T48 5.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"></path>
    </pattern>
  </defs>
  <rect width="100%" height="11" fill={`url(#${id})`}></rect>
</svg>

---
/**
 * The three list panels (socials / events / classes). Renders the groups
 * built by `buildHomepage` and, on the client, follows the shared homepage
 * state: active tab, list vs. calendar view, dance filters and `?event=`.
 */
import EventC from "../event.astro";
import ResponsiveList from "../responsiveList.astro";
import ResponsiveListItem from "../responsiveListItem.astro";
import type { Locale } from "../../i18n";
import type { ListPanel } from "../../lib/homepage";

interface Props {
  locale: Locale;
  panels: ListPanel[];
  /** `?event=` points at an event without upcoming dates. */
  focusMissing?: boolean;
}

const { locale, panels, focusMissing = false } = Astro.props;
const t = (de: string, en: string) => (locale === "en" ? en : de);
---

<p class="event-focus" data-event-focus hidden>
  {t("Es wird nur eine Veranstaltung angezeigt.", "Showing a single event.")}
  <button type="button" class="event-focus__reset" data-event-focus-reset>
    {t("Alle anzeigen", "Show all")}
  </button>
</p>

{
  focusMissing && (
    <p class="event-focus" role="status">
      {t(
        "Diese Veranstaltung hat keine anstehenden Termine mehr. Hier sind alle anderen.",
        "This event has no upcoming dates. Showing everything else instead.",
      )}
    </p>
  )
}

{
  panels.map((panel, index) => (
    <div
      id={`content-${panel.tab}`}
      class:list={["tab-content", { "is-visible is-shown": index === 0 }]}
      role="tabpanel"
      aria-labelledby={`tab-${panel.tab}`}
      data-tab={panel.tab}>
      {panel.groups.length > 0 ? (
        <ResponsiveList exclusiveOpen={false}>
          {panel.groups.map((group) => (
            <div
              class="day-group"
              data-group
              hidden={group.entries.length > 0 && group.entries.every((entry) => entry.focusOnly)}>
              <ResponsiveListItem
                title={group.title}
                id={group.id}
                aside={group.aside}
                isOpen={group.isOpen}>
                {group.entries.length > 0 ? (
                  <div class="centered-list">
                    {group.entries.map((entry) => (
                      <div
                        class="listing-entry"
                        data-entry
                        data-event-id={String(entry.occurrence.eventId)}
                        data-tags={entry.tags}
                        data-focus-only={entry.focusOnly ? "" : undefined}
                        hidden={entry.focusOnly}>
                        <EventC occurrence={entry.occurrence} hideDate={entry.hideDate} />
                      </div>
                    ))}
                  </div>
                ) : (
                  <p class="no-event-today">{panel.groupEmptyText}</p>
                )}
              </ResponsiveListItem>
            </div>
          ))}
        </ResponsiveList>
      ) : (
        <p>{panel.emptyText}</p>
      )}
      {panel.groups.length > 0 && (
        <p class="no-match" data-no-match hidden>
          {panel.noMatchText}
        </p>
      )}
    </div>
  ))
}

<script>
  import { setAccordionOpen } from "../../scripts/accordion";
  import {
    matchesFilters,
    setState,
    subscribe,
    type HomeState,
  } from "../../scripts/homeState";

  const FADE_MS = 300;

  const panels = [...document.querySelectorAll<HTMLElement>(".tab-content[data-tab]")];
  const focusNote = document.querySelector<HTMLElement>("[data-event-focus]");

  document.querySelector("[data-event-focus-reset]")?.addEventListener("click", () => {
    const url = new URL(window.location.href);
    url.searchParams.delete("event");
    history.replaceState(null, "", url);
    setState({ eventId: null });
  });

  // --- Panel visibility -----------------------------------------------------

  // `is-visible` controls display, `is-shown` the opacity transition. Each
  // switch bumps the token, which cancels a fade that is still running.
  let switchToken = 0;

  const setVisible = (panel: HTMLElement, visible: boolean) => {
    panel.classList.toggle("is-visible", visible);
    panel.classList.toggle("is-shown", visible);
  };

  function showPanel(target: HTMLElement | undefined, animate: boolean) {
    const token = ++switchToken;
    const current = panels.find((panel) => panel.classList.contains("is-visible"));

    if (!target || !animate || !current || current === target) {
      for (const panel of panels) setVisible(panel, panel === target);
      return;
    }

    current.classList.remove("is-shown");
    window.setTimeout(() => {
      if (token !== switchToken) return;
      setVisible(current, false);
      target.classList.add("is-visible");
      void target.offsetWidth; // flush display so the opacity transition runs
      target.classList.add("is-shown");
    }, FADE_MS);
  }

  // --- Filtering ------------------------------------------------------------

  function applyFilters({ filters, eventId }: HomeState) {
    const narrowed = filters.size > 0 || eventId !== null;

    for (const panel of panels) {
      let panelHasMatch = false;

      for (const group of panel.querySelectorAll<HTMLElement>("[data-group]")) {
        const entries = [...group.querySelectorAll<HTMLElement>("[data-entry]")];
        // Groups without entries (the empty "today" group) stay as they are.
        if (entries.length === 0) continue;

        let groupHasMatch = false;
        for (const entry of entries) {
          const focusOnly = entry.dataset.focusOnly !== undefined;
          const match =
            matchesFilters((entry.dataset.tags ?? "").split(",").filter(Boolean), filters) &&
            (eventId === null ? !focusOnly : entry.dataset.eventId === eventId);
          entry.hidden = !match;
          groupHasMatch ||= match;
        }

        group.hidden = !groupHasMatch;
        panelHasMatch ||= groupHasMatch;
        const item = group.querySelector(".responsive-item");
        if (narrowed && groupHasMatch && item) setAccordionOpen(item, true);
      }

      const noMatch = panel.querySelector<HTMLElement>("[data-no-match]");
      if (noMatch) noMatch.hidden = !(narrowed && !panelHasMatch);
    }

    if (focusNote) focusNote.hidden = eventId === null;
  }

  subscribe((state, previous, meta) => {
    if (state.filters !== previous.filters || state.eventId !== previous.eventId || !meta.animate) {
      applyFilters(state);
    }

    const target =
      state.view === "list" ? panels.find((panel) => panel.dataset.tab === state.tab) : undefined;
    // Only animate tab changes inside the list view; leaving the calendar or
    // deep links switch instantly.
    const animate = meta.animate && previous.view === "list" && state.tab !== previous.tab;
    showPanel(target, animate);
  });
</script>

<style>
  .tab-content {
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .tab-content.is-visible {
    display: block;
  }

  .tab-content.is-shown {
    opacity: 1;
  }

  [data-entry][hidden],
  [data-group][hidden] {
    display: none;
  }

  .no-event-today {
    margin: 0;
    padding: 0.75rem 0 1rem;
    font-size: var(--fs-body);
    color: var(--text-muted);
    text-align: left;
  }

  .no-match {
    margin-top: 20px;
    color: var(--text-muted);
  }

  .event-focus {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin: 0 0 1.5rem;
    font-size: var(--fs-body);
    color: var(--text-muted);
  }

  .event-focus[hidden] {
    display: none;
  }

  .event-focus__reset {
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
  }
</style>

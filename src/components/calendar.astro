---
import { toJsonScript } from "../utils";

export interface CalendarEntry {
  date: string;
  /** Start time ("20:00"), empty for events without a time. */
  time: string;
  /** "20:00–22:00" / "20:00", empty for events without a time. */
  timeRange: string;
  title: string;
  type: string;
  eventId: string;
  tags: string;
  cancelled: boolean;
}

export interface CalendarEventDetail {
  title: string;
  type: string;
  descriptionHtml: string;
  organizers: string;
  location: string;
}

interface Props {
  locale: string;
  /** First month covered by the dataset, `YYYY-MM`. */
  min: string;
  /** Last month covered by the dataset, `YYYY-MM`. */
  max: string;
  entries: CalendarEntry[];
  /** Event details looked up by id when a pill is opened. */
  events: Record<string, CalendarEventDetail>;
}

const { locale, min, max, entries, events } = Astro.props;
const isGerman = locale === "de";

const data = toJsonScript({ min, max, entries, events });
---

<section
  id="calendar-view"
  class="calendar-view"
  data-locale={locale}
  data-min={min}
  data-max={max}
  aria-label={isGerman ? "Kalender" : "Calendar"}
  hidden>
  <div class="calendar-head">
    <h2 class="calendar-title" data-calendar-month aria-live="polite"></h2>
    <div class="calendar-controls">
      <button
        class="calendar-today"
        type="button"
        data-calendar-today
        aria-label={isGerman ? "Zum aktuellen Monat" : "Go to current month"}>
        {isGerman ? "Heute" : "Today"}
      </button>
      <button
        class="calendar-nav"
        type="button"
        data-calendar-prev
        aria-label={isGerman ? "Vorheriger Monat" : "Previous month"}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <polyline points="15 18 9 12 15 6" />
        </svg>
      </button>
      <button
        class="calendar-nav"
        type="button"
        data-calendar-next
        aria-label={isGerman ? "Nächster Monat" : "Next month"}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </button>
    </div>
  </div>

  <div class="calendar-weekdays" data-calendar-weekdays aria-hidden="true"></div>
  <div class="calendar-grid" data-calendar-grid></div>

  <p class="calendar-empty" data-calendar-empty hidden>
    {isGerman ? "Keine Termine in diesem Monat." : "No events this month."}
  </p>

  <div class="calendar-modal" data-calendar-modal hidden>
    <div class="calendar-modal__backdrop" data-calendar-close></div>
    <div
      class="calendar-modal__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="calendar-modal-title"
      tabindex="-1"
      data-calendar-dialog>
      <button
        class="calendar-modal__close"
        type="button"
        data-calendar-close
        aria-label={isGerman ? "Schließen" : "Close"}>
        <span aria-hidden="true">×</span>
      </button>
      <p class="calendar-modal__kicker" data-modal-kicker></p>
      <h3 class="calendar-modal__title" id="calendar-modal-title" data-modal-title>
      </h3>
      <p class="calendar-modal__meta" data-modal-meta></p>
      <p class="calendar-modal__location" data-modal-location hidden></p>
      <div class="calendar-modal__desc" data-modal-desc></div>
    </div>
  </div>

  <script type="application/json" id="calendar-data" is:inline set:html={data} />
</section>

<script>
  import type { CalendarEntry, CalendarEventDetail } from "./calendar.astro";

  const calendarView = document.getElementById("calendar-view") as
    | HTMLElement
    | null;

  if (calendarView) {
    type Entry = CalendarEntry;
    type EventDetail = CalendarEventDetail;

    const dataEl = document.getElementById("calendar-data");
    let data: {
      min: string;
      max: string;
      entries: Entry[];
      events: Record<string, EventDetail>;
    } | null = null;
    try {
      data = dataEl?.textContent ? JSON.parse(dataEl.textContent) : null;
    } catch (error) {
      console.error("Calendar data could not be parsed", error);
    }

    const grid = calendarView.querySelector<HTMLElement>("[data-calendar-grid]");
    const weekdaysEl = calendarView.querySelector<HTMLElement>(
      "[data-calendar-weekdays]",
    );
    const monthLabel = calendarView.querySelector<HTMLElement>(
      "[data-calendar-month]",
    );
    const emptyEl = calendarView.querySelector<HTMLElement>(
      "[data-calendar-empty]",
    );
    const prevButton = calendarView.querySelector<HTMLButtonElement>(
      "[data-calendar-prev]",
    );
    const nextButton = calendarView.querySelector<HTMLButtonElement>(
      "[data-calendar-next]",
    );
    const todayButton = calendarView.querySelector<HTMLButtonElement>(
      "[data-calendar-today]",
    );
    const modal = calendarView.querySelector<HTMLElement>(
      "[data-calendar-modal]",
    );
    const dialog = calendarView.querySelector<HTMLElement>(
      "[data-calendar-dialog]",
    );
    const modalKicker = calendarView.querySelector<HTMLElement>(
      "[data-modal-kicker]",
    );
    const modalTitle = calendarView.querySelector<HTMLElement>(
      "[data-modal-title]",
    );
    const modalMeta = calendarView.querySelector<HTMLElement>("[data-modal-meta]");
    const modalLocation = calendarView.querySelector<HTMLElement>(
      "[data-modal-location]",
    );
    const modalDesc = calendarView.querySelector<HTMLElement>(
      "[data-modal-desc]",
    );
    const toggleButton = document.getElementById("calendar-toggle");

    const isGerman = calendarView.dataset.locale === "de";
    const localeCode = isGerman ? "de-DE" : "en-GB";
    const monthFormat = new Intl.DateTimeFormat(localeCode, {
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    });
    const weekdayFormat = new Intl.DateTimeFormat(localeCode, {
      weekday: "short",
      timeZone: "UTC",
    });
    const modalDateFormat = new Intl.DateTimeFormat(localeCode, {
      weekday: "long",
      day: "2-digit",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    });

    const typeLabels: Record<string, { de: string; en: string }> = {
      social: { de: "Social", en: "Social" },
      event: { de: "Event", en: "Event" },
      class: { de: "Kurs", en: "Class" },
    };
    const tabTypes: Record<string, string> = {
      socials: "social",
      events: "event",
      classes: "class",
    };

    const todayKey = new Intl.DateTimeFormat("en-CA", {
      timeZone: "Europe/Berlin",
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).format(new Date());

    const [minYear, minMonth] = (data?.min ?? todayKey.slice(0, 7))
      .split("-")
      .map(Number);
    const [maxYear, maxMonth] = (data?.max ?? todayKey.slice(0, 7))
      .split("-")
      .map(Number);

    let currentYear = Number(todayKey.slice(0, 4));
    let currentMonth = Number(todayKey.slice(5, 7)) - 1;
    let isOpen = false;

    const entriesByDate = new Map<string, Entry[]>();
    for (const entry of data?.entries ?? []) {
      const bucket = entriesByDate.get(entry.date);
      if (bucket) bucket.push(entry);
      else entriesByDate.set(entry.date, [entry]);
    }

    const pad = (value: number) => String(value).padStart(2, "0");
    const monthKey = (year: number, monthIndex: number) =>
      `${year}-${pad(monthIndex + 1)}`;
    const minKey = `${minYear}-${pad(minMonth)}`;
    const maxKey = `${maxYear}-${pad(maxMonth)}`;

    const activeTabType = () => {
      const active = document.querySelector(
        ".page-tabs .tab.active",
      ) as HTMLElement | null;
      return tabTypes[active?.dataset.tab ?? "classes"];
    };

    const selectedFilters = () =>
      Array.from(
        document.querySelectorAll<HTMLElement>(".filter-panel .filter-tag.selected"),
      )
        .map((tag) => tag.dataset.filter ?? "")
        .filter(Boolean);

    const entriesForDate = (dateKey: string): Entry[] => {
      const type = activeTabType();
      const filters = selectedFilters();
      return (entriesByDate.get(dateKey) ?? []).filter((entry) => {
        if (entry.type !== type) return false;
        if (filters.length === 0) return true;
        return entry.tags
          .split(",")
          .map((tag) => tag.trim())
          .some((tag) => filters.includes(tag));
      });
    };

    const canShowMonth = (year: number, monthIndex: number) => {
      const key = monthKey(year, monthIndex);
      return key >= minKey && key <= maxKey;
    };

    const closeModal = () => {
      if (!modal) return;
      modal.hidden = true;
      document.documentElement.classList.remove("calendar-modal-open");
    };

    const openModal = (entry: Entry) => {
      if (!modal || !dialog) return;
      const detail = data?.events[entry.eventId];
      const kicker =
        typeLabels[entry.type]?.[isGerman ? "de" : "en"] ?? entry.type;

      if (modalKicker) {
        modalKicker.textContent = entry.cancelled
          ? `${kicker} · ${isGerman ? "fällt aus" : "cancelled"}`
          : kicker;
        modalKicker.classList.toggle("is-cancelled", entry.cancelled);
      }
      if (modalTitle) {
        modalTitle.textContent = detail?.title ?? entry.title;
      }
      if (modalMeta) {
        const date = new Date(`${entry.date}T00:00:00Z`);
        modalMeta.textContent = [
          modalDateFormat.format(date),
          entry.timeRange,
          detail?.organizers,
        ]
          .filter(Boolean)
          .join(" · ");
      }
      if (modalLocation) {
        if (detail?.location) {
          modalLocation.textContent = detail.location;
          modalLocation.hidden = false;
        } else {
          modalLocation.hidden = true;
        }
      }
      if (modalDesc) {
        // Safe: produced server-side by Payload's Lexical HTML converter, which
        // escapes all text and replaces unsafe link schemes (javascript:, data:)
        // with "#". Never put unconverted CMS strings here.
        modalDesc.innerHTML = detail?.descriptionHtml ?? "";
        modalDesc.hidden = !detail?.descriptionHtml;
      }

      modal.hidden = false;
      document.documentElement.classList.add("calendar-modal-open");
      dialog.focus();
    };

    const renderWeekdays = () => {
      if (!weekdaysEl || weekdaysEl.childElementCount) return;
      // 2024-01-01 was a Monday.
      for (let index = 0; index < 7; index++) {
        const label = document.createElement("span");
        label.className = "calendar-weekday";
        label.textContent = weekdayFormat
          .format(new Date(Date.UTC(2024, 0, 1 + index)))
          .replace(/\.$/, "");
        weekdaysEl.append(label);
      }
    };

    const renderCalendar = () => {
      if (!grid || !monthLabel || !data) return;

      monthLabel.textContent = monthFormat.format(
        new Date(Date.UTC(currentYear, currentMonth, 1)),
      );

      if (prevButton) {
        prevButton.disabled = monthKey(currentYear, currentMonth) <= minKey;
      }
      if (nextButton) {
        nextButton.disabled = monthKey(currentYear, currentMonth) >= maxKey;
      }

      renderWeekdays();
      grid.replaceChildren();

      const firstWeekday =
        (new Date(Date.UTC(currentYear, currentMonth, 1)).getUTCDay() + 6) % 7;
      const daysInMonth = new Date(
        Date.UTC(currentYear, currentMonth + 1, 0),
      ).getUTCDate();

      const appendBlank = () => {
        const blank = document.createElement("div");
        blank.className = "calendar-day calendar-day--blank";
        blank.setAttribute("aria-hidden", "true");
        grid.append(blank);
      };

      for (let index = 0; index < firstWeekday; index++) appendBlank();

      let monthHasEntries = false;
      for (let day = 1; day <= daysInMonth; day++) {
        const dateKey = `${currentYear}-${pad(currentMonth + 1)}-${pad(day)}`;
        const cell = document.createElement("div");
        cell.className = "calendar-day";
        if (dateKey === todayKey) cell.classList.add("calendar-day--today");

        const header = document.createElement("div");
        header.className = "calendar-day-head";
        const dayNumber = document.createElement("span");
        dayNumber.className = "calendar-day-number";
        dayNumber.textContent = String(day);
        header.append(dayNumber);
        cell.append(header);

        const dayEntries = entriesForDate(dateKey);
        if (dayEntries.length > 0) monthHasEntries = true;

        for (const entry of dayEntries) {
          const pill = document.createElement("button");
          pill.type = "button";
          pill.className = "calendar-pill";
          if (entry.cancelled) pill.classList.add("is-cancelled");
          pill.title = [entry.timeRange, entry.title].filter(Boolean).join(" ");

          if (entry.time) {
            const time = document.createElement("span");
            time.className = "calendar-pill__time";
            time.textContent = entry.time;
            pill.append(time);
          }

          const title = document.createElement("span");
          title.className = "calendar-pill__title";
          title.textContent = entry.title;
          pill.append(title);
          pill.addEventListener("click", () => openModal(entry));
          cell.append(pill);
        }

        grid.append(cell);
      }

      const filled = firstWeekday + daysInMonth;
      for (let index = filled; index % 7 !== 0; index++) appendBlank();

      if (emptyEl) emptyEl.hidden = monthHasEntries;
    };

    const shiftMonth = (delta: number) => {
      const target = new Date(Date.UTC(currentYear, currentMonth + delta, 1));
      const year = target.getUTCFullYear();
      const monthIndex = target.getUTCMonth();
      if (!canShowMonth(year, monthIndex)) return;
      currentYear = year;
      currentMonth = monthIndex;
      renderCalendar();
    };

    const setOpen = (open: boolean) => {
      isOpen = open;
      calendarView.hidden = !open;
      toggleButton?.classList.toggle("active", open);
      toggleButton?.setAttribute("aria-pressed", String(open));

      if (open) {
        document.querySelectorAll<HTMLElement>(".tab-content").forEach((panel) => {
          panel.style.display = "none";
          panel.style.opacity = "0";
          panel.classList.remove("active-content");
        });
        closeModal();
        renderCalendar();
      } else {
        closeModal();
        document.dispatchEvent(new CustomEvent("sip:calendar-close"));
      }
    };

    prevButton?.addEventListener("click", () => shiftMonth(-1));
    nextButton?.addEventListener("click", () => shiftMonth(1));
    todayButton?.addEventListener("click", () => {
      const year = Number(todayKey.slice(0, 4));
      const monthIndex = Number(todayKey.slice(5, 7)) - 1;
      if (!canShowMonth(year, monthIndex)) return;
      currentYear = year;
      currentMonth = monthIndex;
      renderCalendar();
    });

    calendarView
      .querySelectorAll<HTMLElement>("[data-calendar-close]")
      .forEach((element) => {
        element.addEventListener("click", closeModal);
      });

    document.addEventListener("keydown", (event) => {
      if (!isOpen) return;
      if (event.key === "Escape" && modal && !modal.hidden) {
        event.preventDefault();
        closeModal();
        return;
      }
      if (modal && !modal.hidden) return;
      const target = event.target as HTMLElement | null;
      if (target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        shiftMonth(-1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        shiftMonth(1);
      }
    });

    (window as any).sipCalendar = {
      isOpen: () => isOpen,
      open: () => setOpen(true),
      close: () => setOpen(false),
      toggle: () => setOpen(!isOpen),
      refresh: () => {
        if (isOpen) renderCalendar();
      },
    };
  }
</script>

<style is:global>
  .calendar-view {
    --calendar-line: color-mix(in srgb, var(--text-main) 16%, transparent);
    border: var(--rule-width) solid var(--rule-color);
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: var(--surface);
    color: var(--text-main);
    font-family: var(--font-body);
  }

  .calendar-view[hidden] {
    display: none;
  }

  html.calendar-modal-open,
  html.calendar-modal-open body {
    overflow: hidden;
  }

  /* --- Accent header --- */
  .calendar-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1.25rem;
    background-color: var(--accent);
    color: var(--accent-contrast);
  }

  .calendar-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--accent-contrast);
  }

  .calendar-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .calendar-today {
    padding: 0.25rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--accent-contrast) 55%, transparent);
    border-radius: 999px;
    background: none;
    color: var(--accent-contrast);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .calendar-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0.3rem;
    border: 1px solid color-mix(in srgb, var(--accent-contrast) 55%, transparent);
    border-radius: 50%;
    background: none;
    color: var(--accent-contrast);
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      opacity 0.15s ease;
  }

  .calendar-nav svg {
    width: 100%;
    height: 100%;
  }

  .calendar-nav:disabled {
    opacity: 0.35;
    cursor: default;
  }

  @media (hover: hover) {
    .calendar-today:hover {
      background-color: var(--accent-contrast);
      color: var(--accent);
    }

    .calendar-nav:not(:disabled):hover {
      background-color: var(--accent-contrast);
      color: var(--accent);
    }
  }

  /* --- Weekday row --- */
  .calendar-weekdays {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    background-color: var(--accent-soft);
    border-bottom: 1px solid var(--calendar-line);
  }

  .calendar-weekday {
    padding: 0.6rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* --- Month grid --- */
  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }

  .calendar-day {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    min-height: 6.5rem;
    padding: 0.4rem 0.45rem 0.5rem;
    border-right: 1px solid var(--calendar-line);
    border-bottom: 1px solid var(--calendar-line);
  }

  .calendar-day:nth-child(7n) {
    border-right: none;
  }

  .calendar-day--blank {
    background-color: color-mix(in srgb, var(--text-main) 3%, transparent);
  }

  .calendar-day--today {
    background-color: var(--accent-soft);
  }

  .calendar-day-head {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .calendar-day-number {
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .calendar-day--today .calendar-day-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.25rem;
    border-radius: 999px;
    background-color: var(--accent);
    color: var(--accent-contrast);
  }

  /* --- Event pills --- */
  .calendar-pill {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    width: 100%;
    min-width: 0;
    padding: 0.2rem 0.5rem;
    border: none;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--text-main);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .calendar-pill__time {
    flex: 0 0 auto;
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .calendar-pill__title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .calendar-pill.is-cancelled {
    opacity: 0.55;
  }

  .calendar-pill.is-cancelled .calendar-pill__title {
    text-decoration: line-through;
  }

  @media (hover: hover) {
    .calendar-pill:hover {
      background-color: var(--accent);
      color: var(--accent-contrast);
    }

    .calendar-pill:hover .calendar-pill__time {
      color: var(--accent-contrast);
    }
  }

  .calendar-empty {
    margin: 0;
    padding: 1.5rem;
    border-top: 1px solid var(--calendar-line);
    font-size: var(--fs-small);
    color: var(--text-muted);
    text-align: center;
  }

  /* --- Detail dialog --- */
  .calendar-modal[hidden] {
    display: none;
  }

  .calendar-modal {
    position: fixed;
    inset: 0;
    /* Above the sticky site header (z-index 2000), so the whole page dims. */
    z-index: 3000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }

  .calendar-modal__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(20, 30, 45, 0.5);
    backdrop-filter: blur(2px);
  }

  .calendar-modal__dialog {
    position: relative;
    width: min(34rem, 100%);
    max-height: min(85vh, 42rem);
    overflow-y: auto;
    padding: 2rem;
    border-radius: 0.75rem;
    background-color: var(--surface);
    color: var(--text-main);
    box-shadow: 0 1.5rem 3rem rgba(20, 30, 45, 0.25);
    outline: none;
  }

  .calendar-modal__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: none;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  @media (hover: hover) {
    .calendar-modal__close:hover {
      background-color: var(--accent-soft);
      color: var(--accent);
    }
  }

  .calendar-modal__kicker {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .calendar-modal__kicker.is-cancelled {
    color: var(--warning);
  }

  .calendar-modal__title {
    margin: 0 0 0.75rem;
    padding-right: 2rem;
    font-family: var(--font-display);

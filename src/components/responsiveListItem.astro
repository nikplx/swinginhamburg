---
// src/components/responsiveListItem.astro
interface Props {
  title: string;
  id?: string;
  isOpen?: boolean;
  border?: string;
  /** "plus" shows the circled ± control from the design (used on Tanzschulen) */
  indicator?: "none" | "plus";
  /** Secondary line under the title (e.g. the school's districts) */
  subtitle?: string;
  /** Dance pills shown under the title on Tanzschulen */
  tags?: string[];
}

const {
  title,
  id,
  isOpen = false,
  border = "solid",
  indicator = "none",
  subtitle,
  tags = [],
} = Astro.props;
---

<div class={`list-group responsive-item ${isOpen ? "open" : ""}`} id={id}>
  <button
    class="group-header responsive-item-header"
    aria-expanded={isOpen ? "true" : "false"}>
    <span class="list-header-text">
      <span class="list-label">{title}</span>
      {subtitle && <span class="list-subtitle">{subtitle}</span>}
      {
        tags.length > 0 && (
          <span class="list-tags">
            {tags.map((tag) => (
              <span class="listing-tag list-tag">{tag}</span>
            ))}
          </span>
        )
      }
    </span>
    {
      indicator === "plus" && (
        <span class="toggle-mark" aria-hidden="true">
          <span class="toggle-mark-h" />
          <span class="toggle-mark-v" />
        </span>
      )
    }
  </button>
  <div class="list-content responsive-content">
    <div class="centered-list responsive-content-inner">
      <slot />
    </div>
  </div>
</div>

<style define:vars={{ border }}>
  .responsive-content-inner {
    padding-bottom: 0.5rem;
  }

  .list-group {
    width: 100%;
    display: flex;
    flex-direction: column;
    border-top: var(--rule-width) solid var(--rule-color);
  }

  .group-header {
    width: 100%;
    background: none;
    border: none;
    padding: 0.6875rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    cursor: pointer;
    color: var(--text-main);
    text-align: left;
    font: inherit;
  }

  .list-header-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .list-label {
    font-family: var(--font-display);
    font-size: var(--fs-row);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }

  .list-subtitle {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: 400;
    line-height: 1.3;
    color: var(--text-main);
  }

  .list-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.375rem;
  }

  .group-header:hover .list-label {
    color: var(--accent);
  }

  .responsive-item.open .list-label {
    color: var(--accent);
  }

  /* Circled ± control */
  .toggle-mark {
    position: relative;
    flex: 0 0 auto;
    width: 2.125rem;
    height: 2.125rem;
    border: var(--rule-width) solid var(--rule-color);
    border-radius: 50%;
    color: var(--rule-color);
    display: grid;
    place-items: center;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .group-header:hover .toggle-mark,
  .responsive-item.open .toggle-mark {
    color: var(--accent);
    border-color: var(--accent);
  }

  .toggle-mark-h,
  .toggle-mark-v {
    position: absolute;
    background-color: currentColor;
    border-radius: 1px;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .toggle-mark-h {
    width: 0.875rem;
    height: 2px;
  }

  .toggle-mark-v {
    width: 2px;
    height: 0.875rem;
  }

  .responsive-item.open .toggle-mark-v {
    transform: scaleY(0);
    opacity: 0;
  }

  /* Collapse animation */
  .list-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease-out;
  }

  .responsive-item.open .list-content {
    max-height: 120rem;
  }

  .list-content > .centered-list {
    min-height: 0;
  }
</style>

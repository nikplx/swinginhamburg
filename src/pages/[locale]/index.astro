---
import "../../styles/global.css";
import type { Locale } from "../../i18n";
import Calendar from "../../components/calendar.astro";
import EventC from "../../components/event.astro";
import RichText from "../../components/richtText.astro";
import ResponsiveList from "../../components/responsiveList.astro";
import ResponsiveListItem from "../../components/responsiveListItem.astro";
import Layout from "../../components/layout.astro";
import { convertLexicalToHTML } from "@payloadcms/richtext-lexical/html";
import {
  addDays,
  decodeAddress,
  fetchOccurrences,
  formatLocalTime,
  payload,
  todayInBerlin,
  type OccurrenceView,
} from "../../utils";

const locale = Astro.params.locale as Locale; // validated in src/middleware.ts
const t = (de: string, en: string) => (locale === "en" ? en : de);

const index = await payload.findGlobal({
  slug: "index",
  locale: locale,
});

// The survey teaser in the design is split into a display headline
// ("Wir würden euch gerne kennenlernen!") and the body copy that follows.
// The CMS stores it as a single richtext block, so split on the first
// sentence boundary and fall back to a single block if none is found.
const richTextToPlain = (node: any): string => {
  if (!node) return "";
  if (node.type === "text") return node.text ?? "";
  if (node.type === "linebreak") return " ";
  return (node.children ?? []).map(richTextToPlain).join("");
};

const pollCopy = richTextToPlain(index.donationBox?.root)
  .replace(/\s+/g, " ")
  .trim();
const pollSentenceEnd = pollCopy.search(/[.!?](\s|$)/);
const pollHeadline =
  pollSentenceEnd === -1 ? pollCopy : pollCopy.slice(0, pollSentenceEnd + 1);
const pollBody =
  pollSentenceEnd === -1 ? "" : pollCopy.slice(pollSentenceEnd + 1).trim();

// Each tab has its own horizon: socials are short-term, classes run for a
// full quarter, ordinary events sit in between.
const from = todayInBerlin();

const addMonths = (date: string, months: number): string => {
  const [year, month] = date.split("-").map(Number);
  return new Date(Date.UTC(year, month - 1 + months, 1))
    .toISOString()
    .slice(0, 10);
};

// The calendar replaces the list view. Its current month plus the next eleven
// are expanded once so month navigation is instant, and embedded as a compact
// dataset (no descriptions).
const calendarFrom = `${from.slice(0, 7)}-01`;
const calendarTo = addDays(addMonths(calendarFrom, 12), -1);

const [
  socialOccurrences,
  eventOccurrences,
  classOccurrences,
  calendarOccurrences,
] = await Promise.all([
  fetchOccurrences({ from, to: addDays(from, 14), locale, type: "social" }),
  fetchOccurrences({ from, to: addDays(from, 30), locale, type: "event" }),
  fetchOccurrences({ from, to: addDays(from, 90), locale, type: "class" }),
  fetchOccurrences({ from: calendarFrom, to: calendarTo, locale }),
]);

const allOccurrences = [
  ...socialOccurrences,
  ...eventOccurrences,
  ...classOccurrences,
];

const WEEKDAY_ORDER = [
  "monday",
  "tuesday",
  "wednesday",
  "thursday",
  "friday",
  "saturday",
  "sunday",
] as const;

const WEEKDAY_LABELS: Record<string, { de: string; en: string }> = {
  monday: { de: "Montag", en: "Monday" },
  tuesday: { de: "Dienstag", en: "Tuesday" },
  wednesday: { de: "Mittwoch", en: "Wednesday" },
  thursday: { de: "Donnerstag", en: "Thursday" },
  friday: { de: "Freitag", en: "Friday" },
  saturday: { de: "Samstag", en: "Saturday" },
  sunday: { de: "Sonntag", en: "Sunday" },
};

const weekdayKey = (iso: string) =>
  new Intl.DateTimeFormat("en-US", {
    timeZone: "Europe/Berlin",
    weekday: "long",
  })
    .format(new Date(iso))
    .toLowerCase();

const currentWeekday = weekdayKey(new Date().toISOString());

// The classes tab is a weekly schedule, not a date calendar: one entry per
// class and weekday, using the next upcoming occurrence. This keeps recurring
// classes from repeating every week, like the old class list.
const classGroups: Record<string, OccurrenceView[]> = {};
const seenClassSlots = new Set<string>();

for (const occurrence of classOccurrences) {
  const weekday = weekdayKey(occurrence.start);
  const slot = `${occurrence.eventId}|${weekday}`;
  if (seenClassSlots.has(slot)) continue;
  seenClassSlots.add(slot);
  (classGroups[weekday] ??= []).push(occurrence);
}

const classWeekdays = WEEKDAY_ORDER.filter((weekday) => classGroups[weekday]?.length);
const hasTodayClasses = Boolean(classGroups[currentWeekday]);

// Sorted per day by start time.
for (const weekday of classWeekdays) {
  classGroups[weekday].sort((a, b) => a.start.localeCompare(b.start));
}

const tagsFor = (occurrence: OccurrenceView) =>
  occurrence.event.danceStyles
    .map((style) => (style.slug ?? style.shortName ?? "").toLowerCase())
    .filter(Boolean)
    .join(",");

// Compact dataset for the calendar widget (rendered client-side).
const calendarEntries = calendarOccurrences.map((occurrence) => ({
  date: occurrence.date,
  time: formatLocalTime(occurrence.start),
  end: formatLocalTime(occurrence.end),
  title: occurrence.event.title,
  type: occurrence.event.type,
  eventId: String(occurrence.eventId),
  tags: tagsFor(occurrence),
  cancelled: occurrence.cancelled,
}));

// Descriptions (and the other detail fields) are stored once per event so the
// calendar payload does not repeat them for every occurrence.
const calendarEvents: Record<
  string,
  {
    title: string;
    type: string;
    descriptionHtml: string;
    organizers: string;
    location: string;
  }
> = {};

for (const occurrence of calendarOccurrences) {
  const key = String(occurrence.eventId);
  if (calendarEvents[key]) continue;
  const event = occurrence.event;
  const address = decodeAddress(event.location?.address);
  calendarEvents[key] = {
    title: event.title,
    type: event.type,
    descriptionHtml: event.description
      ? convertLexicalToHTML({ data: event.description as any })
      : "",
    organizers: event.organizers
      .map((organizer) => organizer.name)
      .filter(Boolean)
      .join(" · "),
    location: [
      ...new Set(
        [event.location?.name, address.location ?? address.city].filter(
          Boolean,
        ),
      ),
    ].join(" · "),
  };
}

// Dance-style filter tags, same behaviour as the old client-side filter panel.
const uniqueDances = new Map<string, string>();
for (const occurrence of [...allOccurrences, ...calendarOccurrences]) {
  for (const style of occurrence.event.danceStyles) {
    const key = (style.slug ?? style.shortName ?? "").toLowerCase();
    if (key) uniqueDances.set(key, style.name ?? style.shortName ?? key);
  }
}
const danceFilters = [...uniqueDances.entries()].map(([slug, name]) => ({ slug, name }));

// Socials and events share the classes layout: one collapsible per date,
// with every occurrence of that day underneath. Dates are used as the
// collapsible header instead of weekdays because these are one-off listings.
// Dates stay in the German convention on both language versions.
const weekdayFormat = new Intl.DateTimeFormat("de-DE", {
  timeZone: "Europe/Berlin",
  weekday: "long",
});
const dateFormat = new Intl.DateTimeFormat("de-DE", {
  timeZone: "Europe/Berlin",
  day: "2-digit",
  month: "2-digit",
});
const formatGroupDate = (date: string) => {
  const value = new Date(`${date}T12:00:00Z`);
  return {
    weekday: weekdayFormat.format(value),
    dateLabel: dateFormat.format(value),
  };
};

const groupByDate = (items: OccurrenceView[]) => {
  const groups = new Map<string, OccurrenceView[]>();
  for (const item of items) {
    const bucket = groups.get(item.date);
    if (bucket) bucket.push(item);
    else groups.set(item.date, [item]);
  }
  return [...groups.entries()]
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([date, occurrences]) => {
      const { weekday, dateLabel } = formatGroupDate(date);
      return {
        date,
        label: `${dateLabel} ${weekday}`,
        occurrences: occurrences.sort((a, b) =>
          a.start.localeCompare(b.start),
        ),
        isToday: false,
      };
    });
};

// The today group is always present, even without events, so visitors see
// immediately whether anything is happening today.
const markToday = (groups: ReturnType<typeof groupByDate>) => {
  const hasToday = groups.some((group) => group.date === from);
  const result = groups.map((group) => ({
    ...group,
    isToday: group.date === from,
  }));
  if (!hasToday) {
    const { weekday, dateLabel } = formatGroupDate(from);
    result.unshift({
      date: from,
      label: `${dateLabel} ${weekday}`,
      occurrences: [],
      isToday: true,
    });
  }
  return result;
};

const eventPanels = [
  {
    key: "socials",
    dateGroups: markToday(groupByDate(socialOccurrences)),
    empty: t(
      "Keine anstehenden Socials in den nächsten 14 Tagen.",
      "No upcoming socials in the next 14 days.",
    ),
    noMatch: t(
      "Keine Socials entsprechen den ausgewählten Filtern.",
      "No socials match the selected filters.",
    ),
    todayEmpty: t(
      "Heute gibt es keine Veranstaltung.",
      "There is no event today.",
    ),
  },
  {
    key: "events",
    dateGroups: markToday(groupByDate(eventOccurrences)),
    empty: t(
      "Keine anstehenden Events in den nächsten 30 Tagen.",
      "No upcoming events in the next 30 days.",
    ),
    noMatch: t(
      "Keine Events entsprechen den ausgewählten Filtern.",
      "No events match the selected filters.",
    ),
    todayEmpty: t(
      "Heute gibt es keine Veranstaltung.",
      "There is no event today.",
    ),
  },
];
---

<Layout locale={locale}>
  <Fragment slot="sidebar">
    <div class="greeter">
      <RichText content={index.intro} />
    </div>
    <div class="disclaimer-box">
      <button
        class="disclaimer-toggle"
        type="button"
        aria-controls="disclaimer-panel"
        aria-expanded="true"
        aria-label={t("Umfrage ausblenden", "Hide survey")}>
      </button>
      <button
        class="disclaimer-expand"
        type="button"
        aria-controls="disclaimer-panel"
        aria-expanded="false"
        aria-label={t("Umfrage anzeigen", "Show survey")}>
        <span class="disclaimer-expand-label">{t("Umfrage", "Survey")}</span>
        <span class="disclaimer-expand-icon" aria-hidden="true">+</span>
      </button>
      <div class="disclaimer-panel" id="disclaimer-panel">
        <div class="disclaimer">
          <p class="disclaimer-headline">{pollHeadline}</p>
          {pollBody && <p class="disclaimer-body">{pollBody}</p>}
        </div>
        <div class="disclaimer-button">
          <a href="">
            <span class="disclaimer-cta-kicker">
              {t("Direkt zur", "Take the")}
            </span>
            <span class="disclaimer-cta-title">
              {t("Umfrage", "Survey")}
            </span>
          </a>
        </div>
      </div>
    </div>
  </Fragment>

  <div class="tabs-header">
    <div class="page-tabs">
      <button id="tab-socials" class="tab active" data-tab="socials">
        SOCIALS
      </button>
      <span class="tab-separator">/</span>
      <button id="tab-events" class="tab inactive" data-tab="events">
        EVENTS
      </button>
      <span class="tab-separator">/</span>
      <button id="tab-classes" class="tab inactive" data-tab="classes">
        {t("KURSE", "CLASSES")}
      </button>
    </div>

    <div class="header-controls">
      <button
        id="calendar-toggle"
        class="filter-toggle calendar-toggle"
        type="button"
        aria-pressed="false"
        aria-controls="calendar-view"
        aria-label={t("Kalenderansicht umschalten", "Toggle calendar view")}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="33"
          height="31"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="17" rx="2" />
          <line x1="3" y1="9" x2="21" y2="9" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="13" x2="8" y2="13" />
          <line x1="12" y1="13" x2="12" y2="13" />
          <line x1="16" y1="13" x2="16" y2="13" />
          <line x1="8" y1="17" x2="8" y2="17" />
          <line x1="12" y1="17" x2="12" y2="17" />
        </svg>
      </button>

      {
        danceFilters.length > 0 && (
          <button
            id="filter-toggle"
            class="filter-toggle"
            aria-label={t("Filter umschalten", "Toggle filters")}>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="33"
              height="31"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round">
              <line x1="4" y1="21" x2="4" y2="14" />
              <line x1="4" y1="10" x2="4" y2="3" />
              <line x1="12" y1="21" x2="12" y2="12" />
              <line x1="12" y1="8" x2="12" y2="3" />
              <line x1="20" y1="21" x2="20" y2="16" />
              <line x1="20" y1="12" x2="20" y2="3" />
              <line x1="1" y1="14" x2="7" y2="14" />
              <line x1="9" y1="8" x2="15" y2="8" />
              <line x1="17" y1="16" x2="23" y2="16" />
            </svg>
          </button>
        )
      }
    </div>
  </div>

  {
    danceFilters.length > 0 && (
      <div id="filter-panel" class="filter-panel">
        {danceFilters.map((dance) => (
          <button class="listing-tag filter-tag" data-filter={dance.slug}>
            {dance.name}
          </button>
        ))}
      </div>
    )
  }

  <section data-sidebar-anchor>
    {
      eventPanels.map((panel) => (
        <div
          id={`content-${panel.key}`}
          class:list={[
            "tab-content",
            { "active-content": panel.key === "socials" },
          ]}
          data-tab={panel.key}>
          {panel.dateGroups.length > 0 ? (
            <ResponsiveList maxColumns={1} exclusiveOpen={false}>
              {panel.dateGroups.map((group) => (
                <div class="day-group">
                  <ResponsiveListItem
                    title={group.label}
                    id={`${panel.key}-${group.date}`}
                    aside={group.isToday ? t("← HEUTE", "← TODAY") : undefined}
                    isOpen>
                    {group.occurrences.length > 0 ? (
                      <div class="centered-list">
                        {group.occurrences.map((occurrence) => (
                          <div
                            class="filter-item-wrapper workshop-item"
                            data-event-id={String(occurrence.eventId)}
                            data-tags={tagsFor(occurrence)}>
                            <EventC occurrence={occurrence} hideDate />
                          </div>
                        ))}
                      </div>
                    ) : (
                      <p class="no-event-today">{panel.todayEmpty}</p>
                    )}
                  </ResponsiveListItem>
                </div>
              ))}
            </ResponsiveList>
          ) : (
            <p>{panel.empty}</p>
          )}
          {panel.dateGroups.length > 0 && (
            <p data-no-match style="display: none; color: var(--text-muted); margin-top: 20px;">
              {panel.noMatch}
            </p>
          )}
        </div>
      ))
    }

    <div id="content-classes" class="tab-content" data-tab="classes">
      {classWeekdays.length > 0 ? (
        <ResponsiveList maxColumns={1} exclusiveOpen={false}>
          {classWeekdays.map((weekday, index) => {
            const dayClasses = classGroups[weekday];
            const isToday = weekday === currentWeekday;
            const shouldDefaultOpen = !hasTodayClasses && index === 0;

            return (
              <div class="day-group">
                <ResponsiveListItem
                  title={t(WEEKDAY_LABELS[weekday].de, WEEKDAY_LABELS[weekday].en)}
                  id={weekday}
                  isOpen={isToday || shouldDefaultOpen}>
                  <div class="centered-list">
                    {dayClasses.map((occurrence) => (
                      <div
                        class="filter-item-wrapper class-item"
                        data-event-id={String(occurrence.eventId)}
                        data-tags={tagsFor(occurrence)}>
                        <EventC occurrence={occurrence} hideDate />
                      </div>
                    ))}
                  </div>
                </ResponsiveListItem>
              </div>
            );
          })}
        </ResponsiveList>
      ) : (
        <p>
          {t(
            "Keine anstehenden Kurse in den nächsten 90 Tagen.",
            "No upcoming classes in the next 90 days.",
          )}
        </p>
      )}
    </div>

    <Calendar
      locale={locale}
      min={calendarFrom.slice(0, 7)}
      max={calendarTo.slice(0, 7)}
      entries={calendarEntries}
      events={calendarEvents}
    />
  </section>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // Tab Switching Logic
      const tabButtons = Array.from(
        document.querySelectorAll(".page-tabs .tab"),
      );
      const tabPanels = Array.from(
        document.querySelectorAll(".tab-content"),
      );

      let activePanel =
        tabPanels.find((el) => el.classList.contains("active-content")) ??
        null;
      let swapTimer: ReturnType<typeof setTimeout> | null = null;
      let pendingPanel: HTMLElement | null = null;

      function showPanel(panel: HTMLElement) {
        tabPanels.forEach((el) => {
          const isTarget = el === panel;
          el.classList.toggle("active-content", isTarget);
          el.style.display = isTarget ? "block" : "none";
          el.style.opacity = isTarget ? "1" : "0";
        });
        activePanel = panel;
        pendingPanel = null;
      }

      function switchTab(name, updateHash = true) {
        const tab = tabButtons.find((btn) => btn.dataset.tab === name);
        const panel = tabPanels.find((el) => el.dataset.tab === name);
        if (!tab || !panel) return;

        // Clicking the tab that is already showing does nothing.
        if (tab.classList.contains("active") && panel === activePanel) return;

        if (updateHash && window.location.hash !== `#${name}`) {
          history.replaceState(null, "", `#${name}`);
        }

        tabButtons.forEach((btn) => {
          btn.classList.toggle("active", btn === tab);
          btn.classList.toggle("inactive", btn !== tab);
        });

        // While the calendar is open the tabs only filter the month grid.
        const calendar = (window as any).sipCalendar;
        if (calendar?.isOpen()) {
          calendar.refresh();
          return;
        }

        // Deep links swap instantly; clicks fade the old list out first.
        if (!updateHash) {
          if (swapTimer) clearTimeout(swapTimer);
          swapTimer = null;
          showPanel(panel);
          return;
        }

        // Repeated click on the pending target: let the running fade finish.
        if (swapTimer && pendingPanel === panel) return;

        if (swapTimer) {
          clearTimeout(swapTimer);
          swapTimer = null;
        }

        // Clicked back onto the panel that is still fading out: keep it.
        if (panel === activePanel) {
          panel.style.display = "block";
          panel.classList.add("active-content");
          panel.style.opacity = "1";
          pendingPanel = null;
          return;
        }

        const outgoing = activePanel;
        if (outgoing) outgoing.style.opacity = "0";
        pendingPanel = panel;

        swapTimer = setTimeout(() => {
          swapTimer = null;
          if (outgoing) {
            outgoing.style.display = "none";
            outgoing.classList.remove("active-content");
          }
          // Flush the display change so the opacity transition runs.
          panel.style.display = "block";
          void panel.offsetWidth;
          panel.classList.add("active-content");
          panel.style.opacity = "1";
          activePanel = panel;
          pendingPanel = null;
        }, 300);
      }

      tabButtons.forEach((btn) => {
        btn.addEventListener("click", () => switchTab(btn.dataset.tab));
      });

      // Filter Toggle Logic
      const filterToggle = document.getElementById("filter-toggle");
      const filterPanel = document.getElementById("filter-panel");
      const filterTags = document.querySelectorAll(".filter-tag");

      // Both classes and events use the same wrapper class.
      const allItemWrappers = document.querySelectorAll(".filter-item-wrapper");
      const dayGroups = document.querySelectorAll(".day-group");
      const noMatchMessages = document.querySelectorAll("[data-no-match]");

      let activeFilters = new Set();

      // The calendar widget owns its own rendering (see components/calendar.astro);
      // this page only tells it when the view, the tab or the filters change.
      const calendarToggle = document.getElementById("calendar-toggle");

      calendarToggle?.addEventListener("click", () => {
        const calendar = (window as any).sipCalendar;
        if (!calendar) return;
        if (!calendar.isOpen() && swapTimer) {
          clearTimeout(swapTimer);
          swapTimer = null;
          pendingPanel = null;
        }
        calendar.toggle();
      });

      document.addEventListener("sip:calendar-close", () => {
        const activeTab = tabButtons.find((btn) =>
          btn.classList.contains("active"),
        );
        const panel = tabPanels.find(
          (el) => el.dataset.tab === activeTab?.dataset.tab,
        );
        if (panel) showPanel(panel as HTMLElement);
      });

      // Deep links: #socials / #events / #classes
      const initialTab = window.location.hash.replace("#", "");
      if (tabButtons.some((btn) => btn.dataset.tab === initialTab)) {
        switchTab(initialTab, false);
      }

      // Map popups link back with ?event=<id> to narrow the list to that event.
      const eventParam = new URLSearchParams(window.location.search).get(
        "event",
      );
      if (eventParam) {
        const wrappers = Array.from(
          document.querySelectorAll<HTMLElement>(".filter-item-wrapper"),
        );
        const matches = wrappers.filter(
          (wrapper) => wrapper.dataset.eventId === eventParam,
        );

        if (matches.length > 0) {
          const panel = matches[0].closest<HTMLElement>(".tab-content");
          if (panel?.dataset.tab) switchTab(panel.dataset.tab, false);

          wrappers.forEach((wrapper) => {
            wrapper.style.display = matches.includes(wrapper) ? "" : "none";
          });

          dayGroups.forEach((group) => {
            const groupWrappers = Array.from(
              group.querySelectorAll<HTMLElement>(".filter-item-wrapper"),
            );
            const hasMatch = groupWrappers.some(
              (wrapper) => wrapper.style.display !== "none",
            );
            (group as HTMLElement).style.display = hasMatch ? "" : "none";

            const item = group.querySelector<HTMLElement>(".responsive-item");
            const header = group.querySelector<HTMLElement>(
              ".responsive-item-header",
            );
            if (hasMatch && item && header) {
              item.classList.add("open");
              header.setAttribute("aria-expanded", "true");
            }
          });
        }
      }

      if (filterToggle && filterPanel) {
        filterToggle.addEventListener("click", () => {
          filterPanel.classList.toggle("open");
        });
      }

      function applyFilters() {
        allItemWrappers.forEach((wrapper) => {
          const itemTags = wrapper.dataset.tags
            ? wrapper.dataset.tags.split(",")
            : [];

          if (activeFilters.size === 0) {
            wrapper.style.display = ""; // Show all
          } else {
            const hasMatch = itemTags.some((tag) =>
              activeFilters.has(tag.trim()),
            );
            wrapper.style.display = hasMatch ? "" : "none";
          }
        });

        // Handle empty day blocks and auto-open accordions
        dayGroups.forEach((group) => {
          const wrappers = Array.from(group.querySelectorAll(".filter-item-wrapper"));
          const accordionItem = group.querySelector(".responsive-item");
          const accordionHeader = group.querySelector(
            ".responsive-item-header",
          );

          if (wrappers.length > 0) {
            const hasVisible = wrappers.some(
              (w) => w.style.display !== "none",
            );
            group.style.display = hasVisible ? "" : "none";

            // Auto-open logic: If filters are active and this group has visible items, force it open
            if (
              activeFilters.size > 0 &&
              hasVisible &&
              accordionItem &&
              accordionHeader
            ) {
              accordionItem.classList.add("open");
              accordionHeader.setAttribute("aria-expanded", "true");
            }
          }
        });

        // Show the "nothing matches" note per event panel
        noMatchMessages.forEach((msg) => {
          const panel = msg.closest(".tab-content");
          if (!panel) return;
          const visible = Array.from(
            panel.querySelectorAll(".filter-item-wrapper"),
          ).some((wrapper) => wrapper.style.display !== "none");
          msg.style.display =
            activeFilters.size > 0 && !visible ? "block" : "none";
        });

        (window as any).sipCalendar?.refresh();
      }

      filterTags.forEach((tag) => {
        tag.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          const filterValue = target.dataset.filter;

          if (activeFilters.has(filterValue)) {
            activeFilters.delete(filterValue);
            target.classList.remove("selected");
          } else {
            activeFilters.add(filterValue);
            target.classList.add("selected");
          }
          applyFilters();
        });
      });
    });
  </script>
</Layout>

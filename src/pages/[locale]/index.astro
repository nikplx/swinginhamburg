---
export async function getStaticPaths() {
  const locales = ["en", "de"];
  return locales.map((locale) => ({
    params: { locale },
  }));
}

import "../../styles/global.css";
import Nav from "../../components/nav.astro";
import MapC from "../../components/map.astro";
import ClassC from "../../components/class.astro";
import EventC from "../../components/event.astro";
import type { Class } from "../../../cms/src/payload-types.ts";
import { collect, payload, sortWeekdays, translateWeekday } from "../../utils";
import RichText from "../../components/richtText.astro";
import ResponsiveList from "../../components/responsiveList.astro";
import Layout from "../../components/layout.astro";
import ResponsiveListItem from "../../components/responsiveListItem.astro";

interface Params {
  locale: "en" | "de";
}
const { locale } = Astro.params as Params;

const { docs: classes } = await payload.find({
  pagination: false,
  collection: "classes",
  locale: locale,
  depth: 1, // Ensures relations like 'dances' are populated with their data, not just IDs
});

const today = new Date();
const startOfToday = new Date(
  Date.UTC(
    today.getUTCFullYear(),
    today.getUTCMonth(),
    today.getUTCDate(),
    0,
    0,
    0,
    0,
  ),
);
const endOf60Days = new Date(
  Date.UTC(
    today.getUTCFullYear(),
    today.getUTCMonth(),
    today.getUTCDate() + 60,
    23,
    59,
    59,
    999,
  ),
);

const currentWeekday = new Intl.DateTimeFormat("en-US", { weekday: "long" })
  .format(today)
  .toLowerCase();

const index = await payload.findGlobal({
  slug: "index",
  locale: locale,
});

// The survey teaser in the design is split into a display headline
// ("Wir würden euch gerne kennenlernen!") and the body copy that follows.
// The CMS stores it as a single richtext block, so split on the first
// sentence boundary and fall back to a single block if none is found.
const richTextToPlain = (node: any): string => {
  if (!node) return "";
  if (node.type === "text") return node.text ?? "";
  if (node.type === "linebreak") return " ";
  return (node.children ?? []).map(richTextToPlain).join("");
};

const pollCopy = richTextToPlain(index.donationBox?.root)
  .replace(/\s+/g, " ")
  .trim();
const pollSentenceEnd = pollCopy.search(/[.!?](\s|$)/);
const pollHeadline =
  pollSentenceEnd === -1 ? pollCopy : pollCopy.slice(0, pollSentenceEnd + 1);
const pollBody =
  pollSentenceEnd === -1 ? "" : pollCopy.slice(pollSentenceEnd + 1).trim();

const { docs: upcomingEvents } = await payload.find({
  collection: "events",
  sort: "startDate",
  depth: 1, // ADDED: Ensure events also populate their dance relations
  where: {
    and: [
      { startDate: { greater_than_equal: startOfToday.toISOString() } },
      { startDate: { less_than_equal: endOf60Days.toISOString() } },
    ],
  },
  pagination: false,
  locale: locale,
});

const groupedClasses = classes.sort(sortWeekdays).reduce(
  collect((c) => c.weekday.toLowerCase()),
  {},
);

// --- SIMPLIFIED DANCE EXTRACTION (Classes + Events) ---
const uniqueDancesMap = new Map();

// Helper function to extract dances from an array of docs
const extractDances = (docs: any[]) => {
  docs.forEach((doc) => {
    if (doc.dances && Array.isArray(doc.dances)) {
      doc.dances.forEach((dance: any) => {
        if (dance && dance.shortName) {
          uniqueDancesMap.set(dance.shortName, dance);
        }
      });
    }
  });
};

// Extract from both collections so the filter list is complete
extractDances(classes);
extractDances(upcomingEvents);

const danceFilters = Array.from(uniqueDancesMap.values());
---

<Layout locale={locale}>
  <Fragment slot="sidebar">
    <div class="greeter">
      <RichText content={index.intro} />
    </div>
    <hr class="rule" />
    <div class="disclaimer-box">
      <button
        class="disclaimer-toggle"
        type="button"
        aria-expanded="true"
        aria-controls="disclaimer-panel"
        aria-label={locale === "en" ? "Toggle survey" : "Umfrage ein-/ausklappen"}>
        <span class="disclaimer-toggle-h"></span>
        <span class="disclaimer-toggle-v"></span>
      </button>
      <div class="disclaimer-panel" id="disclaimer-panel">
        <div class="disclaimer">
          <p class="disclaimer-headline">{pollHeadline}</p>
          {pollBody && <p class="disclaimer-body">{pollBody}</p>}
        </div>
        <div class="disclaimer-button">
          <a href="">
            <span class="disclaimer-cta-kicker">
              {locale === "en" ? "Take the" : "Direkt zur"}
            </span>
            <span class="disclaimer-cta-title">
              {locale === "en" ? "Survey" : "Umfrage"}
            </span>
          </a>
        </div>
      </div>
    </div>
  </Fragment>

  <div class="tabs-header">
    <div class="page-tabs">
      <button id="tab-events" class="tab inactive" data-tab="events">
        {locale === "en" ? "Socials" : "Socials"}
      </button>
      <span class="tab-separator">/</span>
      <button id="tab-classes" class="tab active" data-tab="classes">
        {locale === "en" ? "Classes" : "Kurse"}
      </button>
    </div>

    {
      danceFilters.length > 0 && (
        <button
          id="filter-toggle"
          class="filter-toggle"
          aria-label="Toggle Filters">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="36"
            height="35"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round">
            <line x1="4" y1="21" x2="4" y2="14" />
            <line x1="4" y1="10" x2="4" y2="3" />
            <line x1="12" y1="21" x2="12" y2="12" />
            <line x1="12" y1="8" x2="12" y2="3" />
            <line x1="20" y1="21" x2="20" y2="16" />
            <line x1="20" y1="12" x2="20" y2="3" />
            <line x1="1" y1="14" x2="7" y2="14" />
            <line x1="9" y1="8" x2="15" y2="8" />
            <line x1="17" y1="16" x2="23" y2="16" />
          </svg>
        </button>
      )
    }
  </div>

  {
    danceFilters.length > 0 && (
      <div id="filter-panel" class="filter-panel">
        {danceFilters.map((dance) => (
          <button
            class="listing-tag filter-tag"
            data-filter={dance.shortName.toLowerCase()}>
            {dance.name || dance.shortName}
          </button>
        ))}
      </div>
    )
  }

  <section>
    <div id="content-events" class="tab-content">
      <div class="centered-list">
        {
          upcomingEvents.length > 0 ? (
            upcomingEvents.map((event: any) => {
              // Extract tags for events just like classes
              const tags = event.dances
                ? event.dances
                    .map((d: any) => d.shortName?.toLowerCase())
                    .filter(Boolean)
                    .join(",")
                : "";

              return (
                <div class="filter-item-wrapper workshop-item" data-tags={tags}>
                  <EventC event={event} />
                </div>
              );
            })
          ) : (
            <p>
              {locale === "en"
                ? "No upcoming socials in the next 14 days."
                : "Keine anstehenden Socials in den nächsten 14 Tagen."}
            </p>
          )
        }
        {/* Fallback message when events exist but are filtered out */}
        {
          upcomingEvents.length > 0 && (
            <p
              id="no-events-msg"
              style="display: none; color: var(--text-muted); margin-top: 20px;">
              {locale === "en"
                ? "No socials match the selected filters."
                : "Keine Socials entsprechen den ausgewählten Filtern."}
            </p>
          )
        }
      </div>
    </div>
    <div id="content-classes" class="tab-content active-content">
      <ResponsiveList maxColumns={1} exclusiveOpen={false}>
        {
          Object.entries(groupedClasses).map(([weekday, dayClasses], index) => {
            // ... remainder of your map function stays the same
            const isToday = weekday === currentWeekday;
            const hasTodayClasses =
              Object.keys(groupedClasses).includes(currentWeekday);
            const shouldDefaultOpen = !hasTodayClasses && index === 0;

            return (
              <div class="day-group">
                <ResponsiveListItem
                  title={translateWeekday(weekday, locale)}
                  id={weekday.toLowerCase()}
                  isOpen={isToday || shouldDefaultOpen}>
                  <div class="centered-list">
                    {dayClasses.map((data: any) => {
                      const tags = data.dances
                        ? data.dances
                            .map((d: any) => d.shortName.toLowerCase())
                            .join(",")
                        : "";

                      return (
                        <div
                          class="filter-item-wrapper class-item"
                          data-tags={tags}>
                          <ClassC classs={data} />
                        </div>
                      );
                    })}
                  </div>
                </ResponsiveListItem>
              </div>
            );
          })
        }
      </ResponsiveList>
    </div>
  </section>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // Tab Switching Logic
      const tabClasses = document.getElementById("tab-classes");
      const tabEvents = document.getElementById("tab-events");
      const contentClasses = document.getElementById("content-classes");
      const contentEvents = document.getElementById("content-events");

      function switchTab(
        activeBtn,
        inactiveBtn,
        activeView,
        inactiveView,
        updateHash = true,
      ) {
        if (!activeBtn || activeBtn.classList.contains("active")) return;

        if (updateHash) {
          window.location.hash = activeBtn.dataset.tab;
        }

        activeBtn.classList.remove("inactive");
        activeBtn.classList.add("active");
        inactiveBtn.classList.remove("active");
        inactiveBtn.classList.add("inactive");

        if (!updateHash) {
          inactiveView.style.display = "none";
          inactiveView.classList.remove("active-content");
          activeView.style.display = "block";
          activeView.classList.add("active-content");
          activeView.style.opacity = "1";
        } else {
          inactiveView.style.opacity = "0";
          setTimeout(() => {
            inactiveView.classList.remove("active-content");
            inactiveView.style.display = "none";
            activeView.style.display = "block";
            void activeView.offsetWidth;
            activeView.classList.add("active-content");
            activeView.style.opacity = "1";
          }, 300);
        }
      }

      const currentHash = window.location.hash.replace("#", "");
      if (currentHash === "events") {
        switchTab(
          tabEvents,
          tabClasses,
          contentEvents,
          contentClasses,
          false,
        );
      } else if (currentHash === "classes") {
        switchTab(
          tabClasses,
          tabEvents,
          contentClasses,
          contentEvents,
          false,
        );
      }

      if (tabClasses && tabEvents) {
        tabClasses.addEventListener("click", () =>
          switchTab(tabClasses, tabEvents, contentClasses, contentEvents),
        );
        tabEvents.addEventListener("click", () =>
          switchTab(tabEvents, tabClasses, contentEvents, contentClasses),
        );
      }

      // Filter Toggle Logic
      const filterToggle = document.getElementById("filter-toggle");
      const filterPanel = document.getElementById("filter-panel");
      const filterTags = document.querySelectorAll(".filter-tag");

      // Updated: Select ALL wrapppers (both classes and events)
      const allItemWrappers = document.querySelectorAll(".filter-item-wrapper");
      const dayGroups = document.querySelectorAll(".day-group");
      const noEventsMsg = document.getElementById("no-events-msg");

      let activeFilters = new Set();

      if (filterToggle && filterPanel) {
        filterToggle.addEventListener("click", () => {
          filterPanel.classList.toggle("open");
        });
      }

      function applyFilters() {
        let visibleEventsCount = 0;

        allItemWrappers.forEach((wrapper) => {
          const itemTags = wrapper.dataset.tags
            ? wrapper.dataset.tags.split(",")
            : [];

          if (activeFilters.size === 0) {
            wrapper.style.display = ""; // Show all
            if (wrapper.classList.contains("workshop-item")) visibleEventsCount++;
          } else {
            const hasMatch = itemTags.some((tag) =>
              activeFilters.has(tag.trim()),
            );
            wrapper.style.display = hasMatch ? "" : "none";
            if (hasMatch && wrapper.classList.contains("workshop-item"))
              visibleEventsCount++;
          }
        });

        // Handle empty day blocks and auto-open accordions
        dayGroups.forEach((group) => {
          const wrappers = Array.from(group.querySelectorAll(".class-item"));
          const accordionItem = group.querySelector(".responsive-item");
          const accordionHeader = group.querySelector(
            ".responsive-item-header",
          );

          if (wrappers.length > 0) {
            const hasVisible = wrappers.some(
              (w) => w.style.display !== "none",
            );
            group.style.display = hasVisible ? "" : "none";

            // Auto-open logic: If filters are active and this group has visible items, force it open
            if (
              activeFilters.size > 0 &&
              hasVisible &&
              accordionItem &&
              accordionHeader
            ) {
              accordionItem.classList.add("open");
              accordionHeader.setAttribute("aria-expanded", "true");
            }
          }
        });

        if (noEventsMsg) {
          noEventsMsg.style.display =
            visibleEventsCount === 0 && activeFilters.size > 0
              ? "block"
              : "none";
        }
      }

      filterTags.forEach((tag) => {
        tag.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          const filterValue = target.dataset.filter;

          if (activeFilters.has(filterValue)) {
            activeFilters.delete(filterValue);
            target.classList.remove("selected");
          } else {
            activeFilters.add(filterValue);
            target.classList.add("selected");
          }
          applyFilters();
        });
      });
    });
  </script>
</Layout>

<style>
  /* --- Sidebar: intro copy --- */
  .greeter :global(p) {
    font-size: var(--fs-body);
    line-height: 1.33;
    margin: 0 0 1.1em 0;
  }

  .greeter :global(p:last-child) {
    margin-bottom: 0;
  }

  .greeter :global(a) {
    color: inherit;
  }

  /* --- Sidebar: survey teaser --- */
  .disclaimer-box {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    text-align: center;
    margin-top: 0.5rem;
    position: relative;
  }

  /* Collapse control is only shown on the accent card (tablet/mobile) */
  .disclaimer-toggle {
    display: none;
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 1;
    width: 2.125rem;
    height: 2.125rem;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: none;
    border: var(--rule-width) solid var(--accent-contrast);
    border-radius: 50%;
    color: var(--accent-contrast);
    cursor: pointer;
  }

  .disclaimer-toggle-h,
  .disclaimer-toggle-v {
    position: absolute;
    background-color: currentColor;
    border-radius: 1px;
    transition: transform 0.2s ease;
  }

  .disclaimer-toggle-h {
    width: 0.875rem;
    height: 2px;
  }

  .disclaimer-toggle-v {
    width: 2px;
    height: 0.875rem;
    display: none;
  }

  /* Expanded shows "−", collapsed shows "+" */
  .disclaimer-box.collapsed .disclaimer-toggle-v {
    display: block;
  }

  .disclaimer {
    text-align: center;
    color: var(--text-main);
  }

  .disclaimer p {
    margin: 0;
  }

  .disclaimer-headline {
    font-family: var(--font-display);
    font-size: var(--fs-h1); /* 34 */
    font-weight: 700;
    line-height: 1.058; /* 36/34 */
    letter-spacing: 0;
    color: var(--text-main);
  }

  .disclaimer-body {
    margin-top: 0.25rem;
    font-family: var(--font-body);
    font-size: var(--fs-h3); /* 24 */
    font-weight: 400;
    line-height: 1.21; /* 29/24 */
    color: var(--text-main);
  }

  .disclaimer-button {
    margin-top: 1.4375rem; /* 23px between body and CTA */
  }

  .disclaimer-button a {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--fs-h1); /* 34 */
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
  }

  .disclaimer-cta-kicker {
    display: block;
    color: var(--text-main);
  }

  .disclaimer-cta-title {
    display: block;
    font-size: 3.75rem; /* 60 */
    line-height: 1.2; /* 72/60 */
    letter-spacing: 0.04em; /* 2.4px at 60 */
    text-transform: uppercase;
    color: var(--accent);
  }

  .disclaimer-button a:hover .disclaimer-cta-title {
    color: var(--text-main);
  }

  /* --- Content column: title row --- */
  .tabs-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .page-tabs {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    font-family: var(--font-body);
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  button.tab {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  button.tab.active {
    color: var(--text-main);
  }

  button.tab:hover {
    color: var(--accent);
  }

  .tab-separator {
    color: var(--text-muted);
    font-weight: 400;
  }

  .filter-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-main);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    flex: 0 0 auto;
    transition: color 0.15s ease;
  }

  .filter-toggle:hover {
    color: var(--accent);
  }

  /* --- Filter panel --- */
  .filter-panel {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-height: 0;
    margin-bottom: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    transition:
      max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s ease-in-out,
      margin-bottom 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .filter-panel.open {
    max-height: 20rem;
    margin-bottom: 2.5rem;
    opacity: 1;
    pointer-events: auto;
  }

  .filter-panel .listing-tag {
    background-color: transparent;
    color: var(--text-main);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .filter-panel .listing-tag:hover,
  .filter-panel .listing-tag.selected {
    background-color: var(--accent);
    color: var(--accent-contrast);
  }

  /* --- Tab panels --- */
  .tab-content {
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .tab-content.active-content {
    display: block;
    opacity: 1;
  }

  @media (max-width: 1023px) {
    .tabs-header {
      margin-bottom: 2rem;
    }

    .page-tabs {
      font-size: var(--fs-h2);
    }

    /* Survey teaser becomes the accent card from the mobile frames */
    .disclaimer-box {
      padding: 3rem 1.5rem 2rem;
      background-color: var(--accent);
      color: var(--accent-contrast);
      border-radius: 0.5rem;
      margin-top: 0;
      margin-bottom: 1rem;
    }

    .disclaimer-toggle {
      display: flex;
    }

    .disclaimer-box.collapsed .disclaimer-panel {
      display: none;
    }

    .disclaimer-box.collapsed {
      padding-block: 1.75rem;
    }

    .disclaimer,
    .disclaimer p,
    .disclaimer-cta-kicker,
    .disclaimer-cta-title,
    .disclaimer-button a {
      color: var(--accent-contrast);
    }

    .disclaimer-button a:hover .disclaimer-cta-title {
      color: var(--accent-contrast);
      opacity: 0.8;
    }

    .disclaimer-headline {
      font-size: 1.625rem; /* 26 */
      line-height: 1.077; /* 28/26 */
    }

    .disclaimer-body {
      font-size: 1.25rem; /* 20 */
      line-height: 1.21; /* 24.2/20 */
    }

    .disclaimer-button a {
      font-size: 1.5rem; /* 24 */
      line-height: 1.2;
    }

    .disclaimer-cta-title {
      font-size: 3rem; /* 48 */
      line-height: 1.2; /* 57.6/48 */
      letter-spacing: 0.04em;
    }
  }

  @media (max-width: 767px) {
    .sidebar > :global(.rule) {
      display: none;
    }

    /* Full-bleed card on phones */
    .disclaimer-box {
      margin-inline: calc(var(--shell-pad) * -1);
      padding: 3rem var(--shell-pad) 2rem;
      border-radius: 0;
      margin-bottom: 0;
    }

    .disclaimer-toggle {
      right: var(--shell-pad);
    }
  }

  @media (min-width: 1024px) {
    /* The poll block is closed with a straight rule inside the framed column */
    .disclaimer-box {
      padding-bottom: 1.75rem;
      border-bottom: var(--rule-width) solid var(--rule-color);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const box = document.querySelector(".disclaimer-box");
    const toggle = document.querySelector(".disclaimer-toggle");

    if (box && toggle) {
      toggle.addEventListener("click", () => {
        const collapsed = box.classList.toggle("collapsed");
        toggle.setAttribute("aria-expanded", String(!collapsed));
      });
    }
  });
</script>

---
import Calendar from "../../components/calendar.astro";
import HomeToolbar from "../../components/home/HomeToolbar.astro";
import ListingPanels from "../../components/home/ListingPanels.astro";
import SurveyBox from "../../components/home/SurveyBox.astro";
import Layout from "../../components/layout.astro";
import RichText from "../../components/richtText.astro";
import type { Locale } from "../../i18n";
import { buildHomepage } from "../../lib/homepage";
import { addDays, addMonths, fetchOccurrences, todayInBerlin } from "../../lib/occurrences";
import { payload } from "../../utils";

const locale = Astro.params.locale as Locale; // validated in src/middleware.ts
const t = (de: string, en: string) => (locale === "en" ? en : de);

const today = todayInBerlin();
// The calendar covers this month and the next eleven. That range includes
// every list horizon, so one request feeds the whole page.
const calendarFrom = `${today.slice(0, 7)}-01`;
const calendarTo = addDays(addMonths(calendarFrom, 12), -1);

const [index, { occurrences, unavailable }] = await Promise.all([
  // A CMS outage should degrade the page, not fail it.
  payload.findGlobal({ slug: "index", locale }).catch((error) => {
    console.error("[index] global failed:", error);
    return null;
  }),
  fetchOccurrences({ from: calendarFrom, to: calendarTo, locale }),
]);

const home = buildHomepage(occurrences, {
  locale,
  today,
  calendarFrom,
  calendarTo,
  focusEventId: Astro.url.searchParams.get("event"),
});
---

<Layout locale={locale}>
  <Fragment slot="sidebar">
    <div class="greeter">
      <RichText html={index?.introHtml} />
    </div>
    <SurveyBox locale={locale} content={index?.donationBox} />
  </Fragment>

  <HomeToolbar locale={locale} danceFilters={home.danceFilters} />

  {
    unavailable && (
      <p class="data-unavailable" role="status">
        {t(
          "Die Termine konnten gerade nicht geladen werden. Bitte versuche es in ein paar Minuten noch einmal.",
          "Events could not be loaded right now. Please try again in a few minutes.",
        )}
      </p>
    )
  }

  <section data-sidebar-anchor>
    <ListingPanels locale={locale} panels={home.panels} focusMissing={home.focusMissing} />
    <Calendar locale={locale} {...home.calendar} />
  </section>
</Layout>

<script>
  // Initial state from the URL: #socials / #events / #classes picks a tab;
  // ?event=<id> (from map popups) narrows the list to that event and opens
  // the tab that contains it.
  import { isTab } from "../../lib/tabs";
  import { setState } from "../../scripts/homeState";

  const hashTab = window.location.hash.slice(1);
  const eventId = new URLSearchParams(window.location.search).get("event");

  let tab = isTab(hashTab) ? hashTab : undefined;
  let focusedEvent: string | null = null;
  if (eventId) {
    // Unknown or past events are ignored rather than hiding every entry.
    const entry = document.querySelector(`[data-entry][data-event-id="${CSS.escape(eventId)}"]`);
    const panelTab = entry?.closest<HTMLElement>("[data-tab]")?.dataset.tab;
    if (isTab(panelTab)) {
      tab = panelTab;
      focusedEvent = eventId;
    }
  }

  setState({ ...(tab && { tab }), eventId: focusedEvent }, { animate: false });

  // Back/forward between #socials / #events / #classes.
  window.addEventListener("hashchange", () => {
    const next = window.location.hash.slice(1);
    if (isTab(next)) setState({ tab: next });
  });
</script>

<style>
  .greeter :global(p) {
    font-size: var(--fs-body);
    line-height: 1.33;
    margin: 0 0 1.1em 0;
  }

  .greeter :global(p:last-child) {
    margin-bottom: 0;
  }

  .greeter :global(a) {
    color: inherit;
  }

  .data-unavailable {
    margin: 0 0 2rem;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--accent);
    font-size: var(--fs-body);
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const DISMISS_KEY = "sih:survey-dismissed";
    const box = document.querySelector(".disclaimer-box");
    const toggle = document.querySelector(".disclaimer-toggle");
    const expand = document.querySelector(".disclaimer-expand");

    if (box) {
      let collapsed = false;
      try {
        collapsed = localStorage.getItem(DISMISS_KEY) === "1";
      } catch {
        /* storage may be unavailable (private mode) */
      }

      const setCollapsed = (value: boolean) => {
        box.classList.toggle("is-collapsed", value);
        toggle?.setAttribute("aria-expanded", String(!value));
        expand?.setAttribute("aria-expanded", String(!value));
        try {
          if (value) localStorage.setItem(DISMISS_KEY, "1");
          else localStorage.removeItem(DISMISS_KEY);
        } catch {
          /* ignore */
        }
      };

      if (collapsed) setCollapsed(true);

      toggle?.addEventListener("click", () => setCollapsed(true));
      expand?.addEventListener("click", () => setCollapsed(false));
    }
  });
</script>

---
export async function getStaticPaths() {
  const locales = ["en", "de"];
  return locales.map((locale) => ({
    params: { locale },
  }));
}

import "../../styles/global.css";
import Nav from "../../components/nav.astro";
import RichText from "../../components/richtText.astro";
import ResponsiveList from "../../components/responsiveList.astro";
import ResponsiveListItem from "../../components/responsiveListItem.astro";
import { payload } from "../../utils";
import Layout from "../../components/layout.astro";

interface Params {
  locale: "en" | "de";
}
const { locale } = Astro.params as Params;

// Fetch Global Swing Data
const cnt = await payload.findGlobal({
  slug: "swing",
  locale: locale,
});

const dancesResponse = await payload.find({
  collection: "dances",
  locale: locale,
  limit: 100,
});
const dances = dancesResponse.docs || [];
const order = ["Lindy", "Balboa", "Charleston", "Blues", "Shag", "Solo", "Tap"];

// Sort the dances array based on the index of the shortName in the order array
const sortedDances = dances.sort((a, b) => {
  return order.indexOf(a.shortName) - order.indexOf(b.shortName);
});
---

<Layout locale={locale}>
  <Fragment slot="sidebar">
    <div class="page-content sidebar-copy">
      <RichText content={cnt.whatIsSwing} />
    </div>
  </Fragment>

  <h1 class="section-title">
    {locale === "en" ? "Get started" : "Neu hier?"}
  </h1>

  {/* --- RESPONSIVE LIST 1: DANCES --- */}
  {
    sortedDances.length > 0 && (
      <ResponsiveList>
        {sortedDances.map((dance) => {
          return (
            <ResponsiveListItem
              title={dance.name}
              id={dance.shortName?.toLowerCase()}
              isOpen={false}
              indicator="plus">
              <div class="dance-body">
                <RichText content={dance.description} />
              </div>
            </ResponsiveListItem>
          );
        })}
      </ResponsiveList>
    )
  }

  <div class="page-content faq">
    <RichText content={cnt.faq} />
  </div>
</Layout>

<style>
  .section-title {
    font-family: var(--font-body);
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 3.5rem 0;
  }

  .sidebar-copy :global(p) {
    font-size: var(--fs-body);
    line-height: 1.33;
    margin: 0 0 1.1em 0;
  }

  .sidebar-copy :global(p:last-child) {
    margin-bottom: 0;
  }

  .dance-body {
    font-size: var(--fs-body);
    line-height: 1.33;
  }

  .faq {
    margin-top: 3rem;
  }

  @media (max-width: 1023px) {
    .section-title {
      font-size: var(--fs-h2);
      margin-bottom: 2rem;
    }
  }
</style>

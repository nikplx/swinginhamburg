---
export async function getStaticPaths() {
  const locales = ["en", "de"];
  return locales.map((locale) => ({
    params: { locale },
  }));
}

import "../../styles/global.css";
import Nav from "../../components/nav.astro";
import RichText from "../../components/richtText.astro";
import ResponsiveList from "../../components/responsiveList.astro";
import ResponsiveListItem from "../../components/responsiveListItem.astro";
import { payload } from "../../utils";
import Layout from "../../components/layout.astro";
import { shuffleByDay } from "../../utils";

interface Params {
  locale: "en" | "de";
}
const { locale } = Astro.params as Params;

// Fetch Global Swing Data
const cnt = await payload.findGlobal({
  slug: "schools-global",
  locale: locale,
});

// Fetch Schools Collection Data
const schoolsResponse = await payload.find({
  collection: "schools",
  locale: locale,
  limit: 100,
});
const schools = schoolsResponse.docs || [];
const shuffledSchools = shuffleByDay(schools);
---

<Layout locale={locale}>
  <Fragment slot="sidebar">
    <div class="page-content sidebar-copy">
      <RichText content={cnt.howToLearn} />
    </div>
  </Fragment>

  <h1 class="section-title">
    {locale === "en" ? "Schools" : "Tanzschulen"}
  </h1>

  {/* --- SCHOOLS --- */}
  {
    shuffledSchools.length > 0 && (
      <ResponsiveList>
        {shuffledSchools.map((school) => {
          const schoolSlug = school.name
            ? school.name.replaceAll(" ", "").toLocaleLowerCase()
            : "";

          return (
            <ResponsiveListItem
              title={school.name}
              id={schoolSlug}
              isOpen={false}
              indicator="plus">
              <div class="school-body">
                <RichText content={school.description} />
                {school.website && (
                  <p class="school-link-row">
                    <a
                      href={school.website}
                      target="_blank"
                      rel="noopener noreferrer">
                      {locale === "en"
                        ? "Website & contact"
                        : "Internetadresse oder andere Kontaktmöglichkeit"}
                    </a>
                  </p>
                )}
              </div>
            </ResponsiveListItem>
          );
        })}
      </ResponsiveList>
    )
  }
</Layout>

<style>
  .section-title {
    font-family: var(--font-body);
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 3.5rem 0;
  }

  .sidebar-copy :global(p) {
    font-size: var(--fs-body);
    line-height: 1.33;
    margin: 0 0 1.1em 0;
  }

  .sidebar-copy :global(p:last-child) {
    margin-bottom: 0;
  }

  .school-body {
    font-size: var(--fs-body);
    line-height: 1.33;
  }

  .school-link-row {
    margin: 0.75rem 0 0 0;
  }

  .school-link-row a {
    color: var(--accent);
  }

  @media (max-width: 1023px) {
    .section-title {
      font-size: var(--fs-h2);
      margin-bottom: 2rem;
    }
  }
</style>

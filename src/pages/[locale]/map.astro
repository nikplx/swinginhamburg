---
import "../../styles/global.css";
import type { Locale } from "../../i18n";
import MapC from "../../components/map.astro";
import Layout from "../../components/layout.astro";
const locale = Astro.params.locale as Locale; // validated in src/middleware.ts
---
<Layout locale={locale} wide>
  <MapC locale={locale}></MapC>
</Layout>

<style>
  .map-title {
    font-family: var(--font-body);
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 1.5rem 0;
  }

  @media (max-width: 1023px) {
    .map-title {
      font-size: var(--fs-h2);
      margin-bottom: 1rem;
    }
  }
</style>
